<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="assets_common_toasty_notify" inherit_id="web.assets_frontend" name="Toastify Notification">
        <xpath expr="//script[last()]" position="after">
            <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"/>
		</xpath>
        <xpath expr="//link[last()]" position="after">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
		</xpath>
    </template>

    <template id="assets_frontend_reset_password" inherit_id="web.assets_frontend" name="Reset Password Notify">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/odoo_web_login/static/src/js/reset_password_toast.js"/>
        </xpath>
    </template>
</odoo>