<?xml version="1.0" encoding="utf-8"?>
<odoo>

   	 <template id="assets_login" inherit_id="web.assets_frontend">
   	 	<xpath expr="." position="inside">
   	 		<link rel="stylesheet" href="/odoo_web_login/static/src/css/web_login_style.css"/>
   	 		<link rel="stylesheet" href="/odoo_web_login/static/src/css/reset_password.css"/>
   	 	</xpath>
    </template>
    
   	<template id="login_layout" inherit_id="web.login_layout" name="Login Layout Inherit">
   		<xpath expr="//t[@t-set='body_classname']" position="after">
			<t t-set="body_classname" t-value="''"/>
   		</xpath>
   		
   		<xpath expr="//div[hasclass('row')]" position="attributes">
   			<attribute name="class">body_login</attribute>
   		</xpath>
   		
   		<xpath expr="//div[hasclass('o_database_list')]" position="before">
   			<div id="background-wrapper"
   				t-attf-style="background-image: url('#{background_src}');"></div>
   		</xpath>
   		
   		<xpath expr="//div[hasclass('o_database_list')]" position="attributes">
   			<attribute name="class">col-lg-3 col-md-4 col-sm-4 col-xs-11 o_database_list</attribute>
   		</xpath>
   		
   		<xpath expr="//div[hasclass('text-center')]/img" position="attributes">
   			<attribute name="class">company_logo</attribute>
   		</xpath>
   	</template>

   	<template id="login" inherit_id="web.login" name="Login Inherit">
		 <xpath expr="." position="inside">
			<script type="text/javascript" src="/odoo_web_login/static/src/js/reset_password_toast.js"/>
			<script type="text/javascript" src="/odoo_web_login/static/src/js/captcha_query_and_toast.js"/>
<!--			<script type="text/javascript" src="/odoo_web_login/static/src/js/captcha.js"/>-->
			 <style>
				 .oe_login_form {
						background: rgba(255, 255, 255, 0.1); /* Slight transparency */
						backdrop-filter: blur(10px); /* Blur effect */
						padding: 20px;
						border-radius: 10px;
						width: 600px;
						margin: auto;
				     	max-width: 340px;
						box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
						border: 1px solid rgba(255, 255, 255, 0.3);
					}

					.oe_login_form input {
						width: 100%;
						padding: 10px;
						border-radius: 8px;
						border: 1px solid #ccc;
						background: rgba(255, 255, 255, 0.2);
						color: white;
					}

					.oe_login_form label {
						color: white;
						font-weight: bold;
					}

					.oe_login_form .btn-primary {
						background: linear-gradient(to right, #ff416c, #ff4b2b);
						color: white;
						border-radius: 8px;
						padding: 12px;
						font-size: 16px;
						font-weight: bold;
						border: none;
						transition: 0.3s ease-in-out;
					}

					.oe_login_form .btn-primary:hover {
						background: linear-gradient(to right, #ff4b2b, #ff416c);
						transform: scale(1.05);
					}

					.oe_login_form {
						animation: fadeIn 1s ease-in-out;
					}

					@keyframes fadeIn {
						from {
							opacity: 0;
							transform: translateY(-20px);
						}
						to {
							opacity: 1;
							transform: translateY(0);
						}
					}
			 </style>
    	</xpath>

		<xpath expr="//form" position="attributes">
<!--			<attribute name="onsubmit">return validateCaptcha(event);</attribute>-->
		</xpath>

		<xpath expr="//form/div[contains(@class, 'field-password')]" position="after">
				<div class="form-group">
    				<div class="recaptcha-wrapper form-control g-recaptcha" id="recaptcha-container"></div>
				</div>
		</xpath>

<!--		 <xpath expr="//form" position="inside">-->
<!--        <div class="form-group">-->
<!--            <img id="captcha_image" src="data:image/png;base64," alt="CAPTCHA" style="border: 1px solid #ccc;"/>-->
<!--            <a href="javascript:void(0);" onclick="reloadCaptcha();">Refresh</a>-->
<!--        </div>-->
<!--        <div class="form-group">-->
<!--            <label for="captcha_input">Enter CAPTCHA</label>-->
<!--            <input type="text" id="captcha_input" name="captcha_input" required="1"/>-->
<!--        </div>-->
<!--    </xpath>-->

   		<xpath expr="//label[@for='db']" position="replace" />
		<xpath expr="//label[@for='login']" position="replace" />
		<xpath expr="//label[@for='password']" position="replace" />

		<xpath expr="//input[@name='login']" position="attributes">
			<attribute name="placeholder">Email ...</attribute>
			<attribute name="autocomplete">off</attribute>
			<attribute name="autocorrect">off</attribute>
		</xpath>
		
		<xpath expr="//input[@name='password']" position="attributes">
			<attribute name="placeholder">Password ...</attribute>
		</xpath>
		
		<xpath expr="//span[hasclass('input-group-btn')]/a[@href='/web/database/selector']" position="replace">
			<a href="/web/database/selector" class="btn btn-default btn-select"><i class="fa fa-database"></i></a>
		</xpath>
	</template>

	<template id="custom_reset_password" inherit_id="auth_signup.reset_password">
		 <xpath expr="." position="inside">
            <script type="text/javascript" src="/odoo_web_login/static/src/js/password_instruction_list_v3.js"/>
        </xpath>
		<xpath expr="//form" position="before">
			<t t-if="request.params.get('expired_password') == 'true'">
				<div class="expired-password-warning">
					Your password has expired. Please reset it.
				</div>
			</t>
		</xpath>

    </template>

</odoo>
