<?xml version='1.0' encoding='utf-8'?>
<odoo>

        <record id="sale_order_sync_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.sync.inherit.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group/group/field[@name='validity_date']"
                       position="before">
                       <field name="child_po_ref" readonly='1'/>
                       <!-- <field name="test_css" invisible='1'/> -->
                </xpath>
                 <xpath expr="//form/sheet/group/group/field[@name='validity_date']"
                       position="after">
                       <field name="sync_so" readonly='1'/>
                       <field name="ready_for_sync" readonly='1'/>
                       <field name="child_po_id_ref" readonly='1' invisible="1"/>
                       <field name="child_db" readonly='1' invisible="1"/>
                </xpath>
                <!-- <xpath expr="//form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='price_subtotal']"
                       position="after">
                        <button class="oe_highlight" name="update_tax_and_price" 
                        string="Update" type="object"
                        />
                </xpath> -->
                <xpath expr="//form/header"
                       position="inside">
                       <field name="check_picking_status" invisible='1'/>
                       <button class="oe_highlight" name="call_so_sync" 
                        string="Send to Dealers" type="object" attrs="{'invisible': [('check_picking_status','=',False)]}"
                        />
                        <!-- '|','|',('child_po_id_ref', '=', False),('ready_for_sync', '=', False), -->
                </xpath>
            </field>
        </record>



        <record id="sale_picking_sync_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.sync.inherit.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/header/button[@name='button_validate']"
                       position="replace">
                     <button name="button_validate" context="{'current_picking_id':id}" attrs="{'invisible': [('show_validate', '=', False)]}" string="Validate" groups="stock.group_stock_user" type="object" class="oe_highlight"/>

                </xpath>
            </field>
        </record>

