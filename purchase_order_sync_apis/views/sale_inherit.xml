         <record id="dealer_sale_order" model="ir.ui.view">
            <field name="name">sale.order.sync.inherit.tree</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
              <tree string="Quotation" class="o_sale_order" decoration-danger="sync_so==False">
                     <field name="message_needaction" invisible="1"/>
                     <field name="name" string="Quotation Number"/>
                     <field name="date_order" string="Quotation Date"/>
                     <field name="partner_id"/>
                     <field name="user_id"/>
                     <field name="amount_total" sum="Total Tax Included" widget="monetary"/>
                     <field name="currency_id" invisible="1"/>
                     <field name="state"/>
                     <field name="child_po_ref" readonly='1'/>
                     <field name="sync_so" readonly='1'/>
                     <field name="ready_for_sync" readonly='1'/>
                     <field name="child_po_id_ref" readonly='1' invisible="1"/>
                     <field name="child_db" readonly='1' invisible="1"/>
              </tree>
            </field>
        </record>


       <record id="sale.action_quotations" model="ir.actions.act_window">
            <field name="domain">[('sale_aftersales','=','sales'),
                                  ('sale_type','=','others'),
                                  ('child_po_ref','=', False)]</field>
            <field name="context">{'default_sale_type':'others'}</field>
       </record>

       <record id="dealer_order_action_menu" model="ir.actions.act_window">
            <field name="name">Dealer Orders</field>
            <field name="res_model">sale.order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,kanban,calendar,pivot,graph</field>
            <field name="domain">[('child_po_ref','!=', False)]</field>
             <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('purchase_order_sync_apis.dealer_sale_order')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})]"/>
       </record>

       <menuitem id="dealer_order_menu"
            name="Dealers Order"
            parent="sale.sale_order_menu"
            action='purchase_order_sync_apis.dealer_order_action_menu'
            sequence="3"/>

       <menuitem name="Sync log" id="menu_sync_log" action="fleet.fleet_vehicle_action"
              parent="sale.product_menu_catalog" sequence="1"/>
</odoo>
