    <record id="inherit_ars_sale_warranty_alignment_wizard_form" model="ir.ui.view">
        <field name="name">ars.sale.warranty.alignment.wizard.form.inherit</field>
        <field name="model">ars.sale.warranty.alignment.wizard</field>
        <field name="inherit_id" ref="ars_after_sales.view_ars_sale_warranty_alignment_wizard_form"/>
        <field name="arch" type="xml">
            <!-- Example: Adding a new field inside the group -->
            <xpath expr="//group" position="after">
                <group>
                    <field name="split_line_amount" widget="radio"/>
                </group>
<!--                <group>-->
<!--&lt;!&ndash;                    <field name="split_percentage" attrs="{'invisible': [('split_line_amount', '!=', 'do_split')]}"/>&ndash;&gt;-->
<!--                </group>-->
            </xpath>

            <!-- Example: Modifying an existing button -->
            <xpath expr="//button[@name='set_alignment']" position="attributes">
                <attribute name="string">Confirm Alignment</attribute>
                <attribute name="class">btn-success</attribute>
            </xpath>

            <!-- Example: Adding a new button -->
            <xpath expr="//footer" position="inside">
                <button name="new_action" string="New Action" type="object" class="btn-info"/>
            </xpath>
        </field>
    </record>
</odoo>