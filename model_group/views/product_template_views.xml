<!-- views/product_template_views.xml -->
<odoo>
    <record id="view_product_template_form_inherit_model_group" model="ir.ui.view">
        <field name="name">product.template.model.group.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <!-- 1. Add catalog_type as invisible field -->
                <field name="catalog_type" invisible="1"/>

                <!-- 2. Master ID field with proper visibility control -->
                <field name="catalog_type_name" invisible="1"/>
                <field name="master_id"
                       widget="many2one_quick_create"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                       attrs="{'invisible': [('catalog_type_name', '!=', 'Vehicle')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="before">

                <field name="master_id" string="Model Group" readonly="1"/><br/>

            </xpath>
        </field>
    </record>


    <record id="view_account_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.invoice.form.inherit</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="ars_after_sales.invoice_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vin']" position="after">

                <field name="master_id" string="Model Group"/>

            </xpath>
        </field>
    </record>

</odoo>