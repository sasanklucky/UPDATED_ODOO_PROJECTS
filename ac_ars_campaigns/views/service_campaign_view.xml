<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    tree view for vehicle campaigns-->
    <record id="view_campaign_history_tree" model="ir.ui.view">
        <field name="name">campaign.history.tree</field>
        <field name="model">campaign.history</field>
        <field name="arch" type="xml">
            <tree create="0">
                <!--                <field name="campaign_name" invisible="1"/>-->
                <field name="campaign_name_ref"/>
                <!--                <field name="campaign_ref" invisible="1"/>-->
                <field name="campaign_status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="campaign_vehicle_id"/>
                <field name="vin_sn"/>
                <field name="campaign_vehicle_status"/>
                <field name="state"/>
<!--                <field name="campaign_done_date"/>-->
                <field name="dealer_code"/>
                <field name="campaign_service_name"/>
                <field name="camp_cancel_reasons" string="Remark"/>
            </tree>
        </field>
    </record>

    <record id="view_campaign_history_form" model="ir.ui.view">
        <field name="name">campaign.history.form</field>
        <field name="model">campaign.history</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <label for="campaign_name_ref">Campaign Name</label>
                    <h1>
                        <field name="campaign_name_ref"/>
                    </h1>
                    <group>

                        <group>
                            <field name="campaign_status"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <!--                        <separator string="Campaign Vehicle Details"/>-->
                    <group string="Campaign Vehicle Details">
                        <!--                        <label for="state">Campaign State</label>-->

                        <group>
                            <field name="state"/>
                            <field name="campaign_vehicle_id"/>
                            <field name="vin_sn"/>
                            <field name="campaign_vehicle_status"/>
                            <field name="dealer_code"/>
                        </group>
                        <group>
<!--                            <field name="campaign_done_date"/>-->
                            <field name="campaign_service_name"/>
                        </group>
                    </group>
                    <separator string="Exception"/>
                    <!--                    <group string="Exception">-->
                    <field name="camp_cancel_reasons" placeholder="Reason For Cancel"/>
                    <!--                    </group>-->
                    <!--                    </group>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_campaigns_history" model="ir.actions.act_window">
        <field name="name">Service Campaign Records</field>
        <field name="res_model">campaign.history</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Service Campaign Records</p>
        </field>
    </record>

    <menuitem
            id="menu_service_campaigns"
            name="Services Campaign Records"
            parent="master_menu_campaigns"
            action="action_service_campaigns_history"
            sequence="1"/>

</odoo>