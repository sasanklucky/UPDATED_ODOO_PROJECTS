<odoo>
    <data>
        <record id="ac_parts_res_company_inherit" model="ir.ui.view">
            <field name="name">Res Company Inherits</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[1]/group/group[2]/field[@name='company_registry']" position="after">
                    <field name="tan_no" string="Tan No."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>