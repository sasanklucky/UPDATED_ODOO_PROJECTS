<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ars_groups_config_menu_view_excel" model="ir.ui.view">
            <field name="name">ars_config_inherited</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="ars_after_sales.res_config_ars_settings"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invoice_ars_setup']" position="after">
                    <h2>Xlsx report restriction</h2>
                    <div class="row mt16 o_settings_container" id="xlsx_report_settings">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="web_export_view">
                            <div class="o_setting_right_pane">
                                <label string="Select the model"/>
                                <field name="xlsx_model_restrict" widget="many2many_tags"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
