                                <label string="Leads And Appointment"/>
                                <div class="text-muted">
                                    Change Stages of the Pipeline
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label class="col-md-3 o_light_label" string="Team Type"/>
                                        <field name="team_types"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-md-3 o_light_label" string="Type"/>
                                        <field name="app_type" string="Type"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-md-3 o_light_label" string="Stages"/>
                                        <field name="stages_id" string="Stages"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                &lt;!&ndash;</div>&ndash;&gt;
            </xpath>-->
        </field>
    </record>
    <record id="action_rms_config_settings" model="ir.actions.act_window">
        <field name="name">RMS Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_rms_settings"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'ac_rms'}</field>
    </record>
