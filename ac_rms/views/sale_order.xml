<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="rms_sale_order_view_inherited" model="ir.ui.view">
        <field name="name">Sale Order Inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="ars_after_sales.view_order_form_inherit"/>
        <field name="arch" type="xml">
            <field name='partner_id' position="after">
                <field name="main_process_id" groups="base.group_no_one"/>
                <field name="cre_work_flow" invisible="1"/>
                <field name="sa_work_flow" invisible="1"/>
            </field>
            <xpath expr="//form/sheet/div[@name='button_box']/button[@name='action_view_delivery']" position="after">
                <button class="oe_stat_button" type="object"
                            string="Time Line"
                            name="time_line_wizard"
                            icon="fa-table">
                    </button>
            </xpath>
            <xpath expr="//sheet/div[4]/group" position="after">
                <!--<group>-->
                <div style="position: absolute;top: 10%;left: 90%;">
                    <div>
                        <h4 class="o_org_chart_title mb16 mt0">Process Stage</h4>
                        <field name="main_process_wiget" widget="process_stage_chart"/>
                    </div>
                </div>
                <!--</group>-->
            </xpath>
            <xpath expr="//button[@name='action_unlock']" position="after">
                <button class="oe_highlight" name="action_start" groups="ac_rms.group_cre"
                    string="Start" type="object" attrs="{'invisible': [('cre_work_flow', 'in', ('No Operation','Finish','Operation Done'))]}"
                    />
                <button class="oe_highlight" name="action_finish"
                    string="Finish" type="object" attrs="{'invisible': [('cre_work_flow', 'in', ('No Operation','Start','Operation Done'))]}"
                    />

                <button class="oe_highlight" name="action_start"  groups="ac_rms.group_sa"
                    string="Start" type="object" attrs="{'invisible': ['|',('sa_work_flow', 'in', ('No Operation','Finish','Operation Done','SA Delivery Process'))]}"
                    />
                <button class="oe_highlight" name="action_finish"
                    string="Finish" type="object" attrs="{'invisible': ['|',('sa_work_flow', 'in', ('No Operation','Start','Operation Done','Ready for Delivery'))]}"
                    />

            </xpath>

        </field>
    </record>

