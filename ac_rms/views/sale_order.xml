    <record id="action_to_bay_tree" model="ir.actions.act_window">
        <field name="name">RMS Bay</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
        <field name='limit'>20</field>
        <field name="view_id" ref="ars_after_sales.view_quotation_tree_inherit"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
    </record>

    <record id="action_to_order_tree" model="ir.actions.act_window">
        <field name="name">Sale Order Multi Dash</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
        <field name='limit'>20</field>
        <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('ars_after_sales.view_order_tree_inherit')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('ars_after_sales.view_order_form_inherit')})]"/>

        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
    </record>


