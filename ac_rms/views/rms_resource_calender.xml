<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<menuitem id="menu_planner_resource"
        name="Resource Planner"/>
    <record id="rms_resource_calender" model="ir.ui.view">
        <field name="name">resource calender</field>
        <field name="model">planner.calender</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
           <form string="Create an Opportunity">
                    <sheet>
                        <group>
                            <group>
                            	<field name="name"/>
                            	<field name="resource_category"/>
                            	<field name="vehicle"/>
                                <field name="resource"/>
                                <field name="shift_end"/>
                                <field name="activity_types" widget="many2many_tags"/>
                                <field name="vehicle_process"  widget="many2many_tags" attrs="{'invisible': [('vehicle', '=', False)]}"/>
                            </group>
                         </group>
                         <notebook>
                            <page name="members" string="Resource">
                                <field name="member_ids" widget="many2many" options="{'not_delete': True}">
                                    <kanban quick_create="false" create="true" delete="true">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click" style="max-width: 200px">
                                                    <div class="o_kanban_record_top">
                                                        <img t-att-src="kanban_image('res.users', 'image_small', record.id.raw_value)" height="40" width="40" class="oe_avatar oe_kanban_avatar_smallbox mb0"/>
                                                        <div class="o_kanban_record_headings ml8">
                                                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                                                        </div>
                                                        <a t-if="! read_only_mode" type="delete" class="text-danger">
                                                            <i class="fa fa-times"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                            <page name="members" string="Resource Pull">
                                <field name="resorce_pull_ids" widget="many2many" options="{'not_delete': True}">
                                    <kanban quick_create="false" create="true" delete="true">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click" style="max-width: 200px">
                                                    <div class="o_kanban_record_top">
                                                        <img t-att-src="kanban_image('res.users', 'image_small', record.id.raw_value)" height="40" width="40" class="oe_avatar oe_kanban_avatar_smallbox mb0"/>
                                                        <div class="o_kanban_record_headings ml8">
                                                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                                                        </div>
                                                        <a t-if="! read_only_mode" type="delete" class="text-danger">
                                                            <i class="fa fa-times"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                      </sheet>
            </form>
        </field>
    </record>


    <record id="rms_activity_form" model="ir.ui.view">
        <field name="name">RMS Activity Form</field>
        <field name="model">rms.activity.setup</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
           <form string="Create an Opportunity">
                <sheet>
                    <group>
                        <group>
                            <field name="stages"/>
                            <field name="activity_type"/>
                        </group>
                        <group>
                            <field name="mark_as_done"/>
                            <field name="assigned_to"/>
                        </group>
                     </group>
                  </sheet>
            </form>
        </field>
    </record>
    
    <record id="rms_resource_calender_tree" model="ir.ui.view">
        <field name="name">resource calender</field>
        <field name="model">planner.calender</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
          <tree>
          	<field name="name"/>
            <field name="resource_category"/>
          </tree>
        </field>
    </record>

    <record id="rms_activity_tree" model="ir.ui.view">
        <field name="name">RMS Activity Tree</field>
        <field name="model">rms.activity.setup</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
          <tree>
          	<field name="stages"/>
            <field name="activity_type"/>
            <field name="assigned_to"/>
            <field name="mark_as_done"/>
          </tree>
        </field>
    </record>
    
    <record id="action_rms_resource_calender" model="ir.actions.act_window">
        <field name="name">Rms resource calender</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">planner.calender</field>
        <field name="view_id" ref="rms_resource_calender_tree"/>
        <field name="view_mode">form,tree</field>
    </record>

    <record id="action_rms_activity" model="ir.actions.act_window">
        <field name="name">Rms Activity</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rms.activity.setup</field>
        <field name="view_id" ref="rms_activity_tree"/>
        <field name="view_mode">form,tree</field>
    </record>
    <!--<menuitem id="rms_resource_menu" name="Resource Calender"-->
              <!--parent="menu_planner_resource" action="action_rms_resource_calender"-->
              <!--web_icon=""/>-->
    <menuitem id="rms_resource_menu" name="Resource Calender"
              parent="ars_after_sales.menu_aftersales_config" action="action_rms_resource_calender"
              web_icon=""/>

    <menuitem id="rms_activity_menu" name="Automation Activity"
              parent="ars_after_sales.menu_aftersales_config" action="action_rms_activity"
              web_icon=""/>

</odoo>