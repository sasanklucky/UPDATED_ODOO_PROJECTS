<template id="tree_view" name="security tree" >
    <div class="table-search-sect">
        <input type="hidden" name="type" value="ta"/>
        <img class="icon-clk-search" src="wms_login/static/src/img/search-images.png" />
        <ul id="myTags" class="tagit ui-widget ui-widget-content ui-corner-all" style="overflow:hidden;height: 29px;width:17%;float:right;font-size: 0.8em;margin-right:50px;margin-top:6px;" >

        </ul>
        <div style="display:none;" id="search-value">Time Stamp</div>
    </div>
    <div style="padding: 1px 32px 0px 17px;">

        <table class="tree_app_security cls-table-search" style="font-size: 25px; font-family: Roboto; color: #666666;width:100%;">

            <t width="100%" style="border:1px solid grey;font-size:18px;text-align: center;color: #666666;">
                <thead>
                    <tr>
                        <th style="border:1px solid grey;text-align: center;color:white;" width="8%">SL No.</th>
                        <th style="border:1px solid grey;text-align: center;color:white;" width="17%">Reg No.</th>
                        <th style="border:1px solid grey;text-align: center;color:white;" width="20%">Gate-In Time</th>

                        <th style="border:1px solid grey;text-align: center;color:white;" width="20%">Kilometer</th>

                        <th style="border:1px solid grey;text-align: center;color:white;" width="20%">Customer Name</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="i" t-value="0"/>
                    <tr style="border:1px solid black;" class="modal_rows">
                        <t t-set="i" t-value="i+1"/>
                        <td width="8%" style="border:1px solid grey;"><span t-esc='i'/></td>
                        <td width="17%" style="border:1px solid grey;"><!--<span t-esc='p.regn_no'/>--></td>
                        <td width="20%" style="border:1px solid grey;"></td>
                        <td width="20%" style="border:1px solid grey;"><!--<span t-esc='p.mileage_in'/>--></td>
                        <td width="30%" style="border:1px solid grey;text-align:left;"><!--<span t-field='p.partner_id.name'/>--></td>
                    </tr>
                </tbody>
            </t>
            </table>
        </div>
    </template>

    <template id="security_login" name="security login" >
        <t t-call="website.layout">
            <form action="/security_action" id="security" method="post">
            <t t-if="warning_msg">
                <div style="color:red;text-align:center;font-size:20px; font-family: Roboto;">
                    <t t-esc="warning_msg"/>
                </div>
            </t>
            <t t-if="confirmation_msg">
                <div id="confirmation" style="color:blue;text-align:center;font-size:20px;">
                    <img src="/website_service_planner/static/src/img/thumb.png" class="wms_thumb_icon" style="width:93px; height:102px"/>
                    <!--<t t-esc="confirmation_msg"/>-->
                </div>
            </t>
                <div class="col-xs-12">
                    <div class=" col-xs-10 sec tab-view-reg" style="padding: 0px;font-family: Roboto; color: #666666;">
                        <!--<label for="view">Reg No: </label>-->
                        <div>
                            <table width="100%">
                                <tr>
                                    <td class="reg_no_td">Reg No:</td>
                                    <td><input type="text" name="regno" id="regno_vehicle"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-xs-2"></div>
                </div>
                <div class="col-xs-12">
                    <div class="col-xs-10 tab-view">
                        <table align="center">
                            <tr>
                            <td><button type="button" class="btn btn-success reg-ok">OK</button></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-xs-2"/>
                </div>
            </form>
            <div style="height:30px;"/>
            <div class="col-xs-12">
                <div class="col-xs-2 widget-sect first bg-pink">
                    <form method="post" class="sec_clk_count_app" name="app_form" id="app_form" action="/security_action_clk">
                        <div></div>
                        <!--<div class="ico-sect"><img src="/wms_login/static/src/img/appointment1.png"  /></div>-->
                        <div class="apps_count cnt-txt" ><t t-esc="app_count"/></div>
                        <input type="text"  style="display:none;" name="app_ids_nm" t-att-value="app_ids"/>
                        <div class="cnt-txt padb-10">Appointment</div>
                    </form>
                </div>
                <div class="col-xs-2 widget-sect bg-red">
                    <form method="post" class="sec_clk_count_turnup" action="/security_action_clk">
                        <div></div>
                        <div class="apps_count cnt-txt"><t t-esc="turnup_count"/></div>
                        <input type="text" style="display:none;" name="turnup_ids_nm" t-att-value="turnup_ids"/>
                        <div class="cnt-txt padb-10">Turn-up</div>
                    </form>
                </div>
                <div class="col-xs-2 widget-sect bg-green">
                    <form method="post" class="sec_clk_count_walkin" action="/security_action_clk">
                        <div></div>
                        <div class="apps_count cnt-txt"><t t-esc="walk_in_count"/></div>
                        <input type="text" style="display:none;" name="walk_in_nm" t-att-value="walk_in_ids"/>
                        <input type="text" style="display:none;"  name="walk_app_in_nm" t-att-value="walk_app_ids"/>
                        <div class="cnt-txt padb-10">Walk-in</div>
                    </form>
                </div>
                <div class="col-xs-2 widget-sect bg-blue">
                    <form method="post" class="sec_clk_count_testdrive" action="/security_action_clk">
                        <div></div>
                        <div class="apps_count cnt-txt"><t t-esc="testdrive_count"/></div>
                        <input type="text" style="display:none;" name="testdrive_ids_nm" t-att-value="testdrive_ids"/>
                        <div class="cnt-txt padb-10">Test-drive</div>
                    </form>
                </div>
                <div class="col-xs-2 widget-sect last bg-yellow">
                    <form method="post" class="sec_clk_count_delivered" action="/security_action_clk">
                        <div></div>
                        <div class="apps_count cnt-txt"><t t-esc="delivered_count"/></div>
                        <input type="text" style="display:none;" name="delivered_ids_nm" t-att-value="delivered_ids"/>
                        <div class="cnt-txt padb-10">Delivered</div>
                    </form>
                </div>

            </div>
            <div style="height:40px;"></div>
            <div>
                <t t-call="tree_view"/>
            </div>
        </t>
    </template>