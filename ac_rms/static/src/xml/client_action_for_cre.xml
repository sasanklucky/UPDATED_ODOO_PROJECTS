<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="cre_dashboard1">
        <div class="col-xs-12" style="margin-top: 3%;">

            <div class="col-xs-3 single_image" style="padding: 0%;" >
                <img src="/ac_rms/static/src/img/PNG.png" style="width:117%" usemap="#planetmap"/>
                <div style="position: absolute;margin-top: -62%;margin-left: 39%;color: black;font-weight:bold;">My Pending Tasks</div>
                <div style="position: absolute;margin-top: -35%;margin-left: 8%;color: black;font-size: smaller;">Appointment<div class="w3-circle3e">0</div></div>
                <div style="position: absolute;margin-left: 55%;margin-top: -10%;color: black;font-size: smaller;">My Tasks<div class="w3-circle4e">0</div></div>
                <div style="position: absolute;margin-left: 95%;margin-top: -35%;color: black;font-size: smaller;width: 100%;">Walk In<div class="w3-circleex">0</div></div>
                <div style="position: absolute;margin-left: 5%;margin-top: -11%;color: black;font-size: smaller;width: 100%;">Waiting For SA<div id="cre_sa_process" class="w3-circlesa">0</div></div>
                <map name="planetmap">
                    <area shape="rect" coords="30,30,90,90" href="#" class="all_clk" id="app"/>
                    <area shape="rect" coords="130,50,200,200" href="#" class="all_clk" id="my_task"  />
                    <area shape="rect" coords="250,30,350,350" href="#" class="all_clk" id="walkin" />
                    <area shape="rect" coords="124,58,8" href="#" class="all_clk" id="app" />
                </map>
                <script>
                $(document).ready(function() {
                    $('.w3-circlesa').click(function(){
                        var ids = $(this).attr('id');
                        if(ids == 'cre_sa_process'){
                            var text = 'cre_sa_process'
                        }
                        $.ajax({
                                url: "/single_image_click",
                                type: "POST",
                                dataType: 'json',
                                data: JSON.stringify({params: {'text':text}}),
                                contentType: 'application/json',
                            }).done(function(result) {
                                $('#my_pending_task').find('tbody').empty();
                                if(result.result.click_mytask.html_txt){
                                    $('#my_pending_task').find('tbody').append(result.result.click_mytask.html_txt);
                                }
                            });
                    });
                    $('.all_clk').click(function(){
                        var ids = $(this).attr('id');
                        if(ids == 'app'){
                            var text = 'app'
                        }
                        else if(ids == 'my_task'){
                            var text = 'my_task'
                        }
                        else if(ids == 'walkin'){
                            var text = 'walkin'
                        }
                        $.ajax({
                            url: "/single_image_click",
                            type: "POST",
                            dataType: 'json',
                            data: JSON.stringify({params: {'text':text}}),
                            contentType: 'application/json',
                        }).done(function(result) {
                            $('#my_pending_task').find('tbody').empty();
                            if(result.result.click_mytask.html_txt){
                                $('#my_pending_task').find('tbody').append(result.result.click_mytask.html_txt);
                            }
                        });
                    });
                });
            </script>
            </div>
