                </a>
                <a href="#" id="action_wip">
                    <img src="/ac_rms/static/src/img/2c.png" style="width: 66%;margin-top: 1%;margin-left: -36%;"><div style="color: black;position: absolute;top: 88%;font-size: smaller;margin-left: -5%;">WIP<div class="w3-circle13e">0</div></div></img>
