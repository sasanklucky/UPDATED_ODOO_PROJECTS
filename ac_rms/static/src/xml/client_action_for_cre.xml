                    </span>
                </a>
                <a href="#" id="action_returned_vehicle">
                    <span>
                        <img src="/ac_rms/static/src/img/1e.png" style="width: 29%;"><div class="return" style="color: black;position: absolute;top: 89%;font-size: smaller;margin-left: 34%;">Returned Vehicle<div class="w3-circle9e">0</div></div></img>
                    </span>
                </a>
                <span>
                    <img src="/ac_rms/static/src/img/1f.png" style="width: 29%;"><div class="noshow" style="color: black;position: absolute;top: 89%;font-size: smaller;margin-left: 65%;">No Show<div class="w3-circle10e">0</div></div></img>
                </span>
            </div>
            <div class="col-xs-3" style="margin-top: 2%;width: 22%;float: right;margin-right: -1%;padding-right: 0;">
                <div style="margin-left: 15%;position: absolute;top: -16%;font-weight: bold;">Status Till</div>
                <a href="#" id="action_app_till">
