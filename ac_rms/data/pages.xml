<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="menu_securitypage" model="website.menu">
            <field name="name">Security</field>
            <field name="url">/security</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">10</field>
            <field name="website_id" ref="website.default_website"/>
        </record>
        <record id="security" model="ir.ui.view">
                <field name="name">Security</field>
                <field name="type">qweb</field>
                <field name="key">ac_rms.security</field>
                <field name="arch" type="xml">
                    <t name="Security" t-name="security">
                      <t t-call="website.layout">
                        <form action="/security_action" id="security" method="post">
                    <t t-if="warning_msg">
                        <div style="color:red;text-align:center;font-size:20px; font-family: Roboto;">
                            <t t-esc="warning_msg"/>
                        </div>
                    </t>
                    <t t-if="confirmation_msg">
                        <div id="confirmation" style="color:blue;text-align:center;font-size:20px;">
                            <img src="/website_service_planner/static/src/img/thumb.png" class="wms_thumb_icon" style="width:93px; height:102px"/>

                        </div>
                    </t>
                        <div class="col-xs-12">
                            <div class=" col-xs-10 sec tab-view-reg" style="padding: 0px;font-family: Roboto; color: #666666;">

                                <div>
                                    <table width="100%">
                                        <tr>
                                            <td class="reg_no_td">Reg No:</td>
                                            <td><input type="text" name="regno" id="regno_vehicle"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-xs-2"></div>
                        </div>
                        <div class="col-xs-12">
                            <div class="col-xs-10 tab-view">
                                <table align="center">
                                    <tr>
                                    <td><button type="button" class="btn btn-success reg-ok">OK</button></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-xs-2"/>
                        </div>
                    </form>
                      </t>
                    </t>
                </field>
            </record>
            <record id="security_page" model="website.page">
                <field name="url">/security</field>
                <field name="website_published">True</field>
                <field name="view_id" ref="security" />
            </record>
    </data>

