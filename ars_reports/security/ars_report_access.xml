<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="access_report_parts_purchase_report">
            <field name="name">Parts Purchase Report Access</field>
            <field name="model_id" ref="model_parts_purchase_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('dealer_id','=',False),('dealer_id','child_of',[user.company_id.id])]
            </field>
        </record>

