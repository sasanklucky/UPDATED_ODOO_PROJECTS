<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tree view for "parts.purchase.report" -->
        <record id="view_parts_purchase_report_tree" model="ir.ui.view">
            <field name="name">view.parts_purchase_report.tree</field>
            <field name="model">parts.purchase.report</field>
            <field name="type">tree</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <tree string="parts_purchase_report_tree" create="false" delete="false" edit="false" default_order='id asc'>
                    <field name="id" string="Sl. No." />
                    <field name="dealer_code" />
                    <field name="dealer_id" />
                    <field name="dealer_state_id" />
                    <field name="dealer_city_id" />
                    <field name="invoice_no" />
                    <field name="invoice_date" />
                    <field name="po_id" />
                    <field name="po_date" />
                    <field name="vendor" />
                    <field name="vendor_ref" />
<!--                    <field name="part_id" />-->
                    <field name="default_code"/>
                    <field name="part_description" />
                    <field name="part_category" />
                    <field name="hsn_code" />
                    <field name="quantity" />
                    <field name="unit_price" />
                    <field name="cgst_per" />
                    <field name="sgst_per" />
                    <field name="igst_per" />
                    <field name="net_dealer_price" />
                </tree>
            </field>
        </record>
        
        <!-- Search view for "parts.purchase.report" -->
        <record id="view_parts_purchase_report_search" model="ir.ui.view">
            <field name="name">view.parts_purchase_report.search</field>
            <field name="model">parts.purchase.report</field>
            <field name="type">search</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <search string="parts_purchase_report_search">
                    <field name="dealer_code" />
                </search>
            </field>
        </record>
        
        <!-- Main window action for "parts.purchase.report" -->
        <record id="action_parts_purchase_report_act_window" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Parts Purchase Report</field>
            <field name="res_model">parts.purchase.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
            <field name="target">current</field>
            <field name="domain">[]</field>
            <field name="context">\{}</field>
            <field name="search_view_id" ref="view_parts_purchase_report_search" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Parts Purchase Report
                </p>
            </field>
        </record>

        <record id="view_parts_purchase_report_report_wizard" model="ir.ui.view">
            <field name="name">Parts Purchase Report</field>
            <field name="model">parts.purchase.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose your Ro Closed From Date to date">
                    <group>
                        <span><h3>Please select the dealers</h3></span>
                            <field name="company_id" widget="many2many_tags"/>
                        <group>
                            <span><b>From</b></span>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <span><b>To</b></span>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="part_purchase_report_qty" string="Parts Purchase Report" type="object"
                                class="btn-primary"/>
                        <!--                        <button string="Cancel" class="btn-default" special="cancel"/>-->
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_parts_purchase_report_wizard" model="ir.actions.act_window">
            <field name="name">Parts Purchase Report Wizard</field>
            <field name="res_model">parts.purchase.report.wizard</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_reports.view_parts_purchase_report_report_wizard"/>
            <field name="target">new</field>
        </record>

        
        <!-- Main menu for "parts.purchase.report" -->
        <record id="menu_purchase_order_report" model="ir.ui.menu" >
            <field name="name">Parts Purchase Report</field>
            <!-- <field name="sequence" eval="10" /> -->
            <field name="action" ref="action_parts_purchase_report_wizard" />
            <field name="parent_id" ref="account.account_reports_management_menu" />
        </record>
    </data>
</odoo>
