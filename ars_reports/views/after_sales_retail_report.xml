        <record id="view_after_sales_retail_report_wizard" model="ir.ui.view">
            <field name="name">After-Sales retail Report wizard Form</field>
            <field name="model">retail.report.after.sales.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose your Ro Closed From Date to date">
                    <group>
                        <span><h3>Please select the dealers</h3></span>
                            <field name="company_id" widget="many2many_tags"/>
                        <group>
                            <span><b>Ro Closed From</b></span>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <span><b>Ro Closed To</b></span>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="retrieve_stock_qty" string="Open After-sales retail report" type="object"
                                class="btn-primary"/>
                        <!--                        <button string="Cancel" class="btn-default" special="cancel"/>-->
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_after_sales_retail_report_wizard" model="ir.actions.act_window">
            <field name="name">After-Sales retail Report wizard</field>
            <field name="res_model">retail.report.after.sales.wizard</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_reports.view_after_sales_retail_report_wizard"/>
            <field name="target">new</field>
        </record>

        <!-- Main menu for "retail.report" -->
        <record id="menu_after_sales_retail_report" model="ir.ui.menu">
