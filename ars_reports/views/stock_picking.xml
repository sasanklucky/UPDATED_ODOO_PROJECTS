        <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
            <table t-if="o.state!='done'" position="replace">
                <table class="table table-condensed mt48" t-if="o.state!='done'">
                    <thead>
                        <tr>
                            <th class="col-xs-2">
                                <strong>Part No</strong>
                            </th>
                            <th>
                                <strong>Product</strong>
                            </th>
                            <th>
                                <strong>Order Quantity</strong>
                            </th>
                            <th>
                                <strong>NDP Cost</strong>
                            </th>
                            <th>
                                <strong>Tax</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                        <tr t-foreach="lines" t-as="move">
                            <td class="col-xs-2">
                                <span t-field="move.product_id.default_code"/>
                            </td>
                            <td>
                                <span t-field="move.product_id"/>
                                <p t-if="o.picking_type_code == 'outgoing'">
                                    <span t-field="move.product_id.sudo().description_pickingout"/>
                                </p>
                                <p t-if="o.picking_type_code == 'incoming'">
                                    <span t-field="move.product_id.sudo().description_pickingin"/>
                                </p>
                            </td>
                            <td>
                                <span t-field="move.product_uom_qty"/>
                                <span t-field="move.product_uom"/>
                            </td>
                            <td>
                                <span t-field="move.product_id.standard_price"/>
                            </td>
                            <td>
                                <t t-foreach="move.product_id.taxes_id" t-as="product_taxes">
                                    <span t-esc="o.tax_percentage(product_taxes)"/>%
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </table>
            <table t-if="o.move_line_ids and o.state=='done'" position="replace">
                <table class="table table-condensed mt48" t-if="o.move_line_ids and o.state=='done'">
                    <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"
                       groups="stock.group_production_lot"/>
                    <thead>
                        <tr>
                            <th class="col-xs-2">
                                <strong>Part No</strong>
                            </th>
                            <th>
                                <strong>Product</strong>
                            </th>
                            <th name="lot_serial" t-if="has_serial_number">
                                Lot/Serial Number
                            </th>
                            <th class="text-center">
                                <strong>Quantity</strong>
                            </th>
                            <th class="text-center">
                                <strong>NDP Cost</strong>
                            </th>
                            <th class="text-center">
                                <strong>Tax</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_line_ids" t-as="move_line">
                            <td class="col-xs-2">
                                <span t-field="move_line.product_id.default_code"/>
                            </td>
                            <td>
                                <span t-field="move_line.product_id"/>
                                <t t-if="move_line.product_id and move_line.product_id.l10n_in_hsn_code and o.company_id.country_id.code == 'IN'">
                                    <h6>
                                        <strong class="ml16">HSN/SAC Code:</strong>
                                        <span t-field="move_line.product_id.l10n_in_hsn_code"/>
                                    </h6>
                                </t>
                                <p t-if="o.picking_type_code == 'outgoing'">
                                    <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                </p>
                                <p t-if="o.picking_type_code == 'incoming'">
                                    <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                </p>
                            </td>
                            <t t-if="has_serial_number">
                                <td>
                                    <table width="100%">
                                        <tr>
                                            <td>
                                                <span t-field="move_line.lot_id"/>
                                                <t t-if="not move_line.lot_id">
                                                    <span t-field="move_line.lot_name"/>
                                                </t>
                                            </td>
                                            <td name="lot_qty">
                                                <t t-if="move_line.product_qty">
                                                    <span t-field="move_line.product_qty"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </t>
                            <td class="text-center">
                                <span t-field="move_line.qty_done"/>
                                <span t-field="move_line.product_uom_id"/>
                            </td>
                            <td class="text-center" name="product_id_standard_price">
                                <t t-if="move_line.product_id.standard_price">
                                    <span t-field="move_line.product_id.standard_price"/>
                                </t>
                            </td>
                            <td class="text-center">
                                <t t-foreach="move_line.product_id.taxes_id" t-as="product_taxes">
                                    <span t-esc="o.tax_percentage(product_taxes)"/>%
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </table>
            <xpath expr="//table[3]" position="after">
                <div class="row">
                    <div class="col-xs-4 pull-right">
                        <table class="table table-condensed">
                            <tr class="border-black">
                                <td>
                                    <strong>Subtotal</strong>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.amount_untaxed"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-right">
                                    <span t-field="o.amount_tax"/>
                                </td>
                            </tr>
                            <tr class="border-black">
                                <td>
                                    <strong>Total</strong>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

            </xpath>
            <!--            <xpath expr="//table[@class='table table-condensed mt48']/thead/tr/th[1]" position="before">-->
            <!--                <th>-->
            <!--                    <strong>Reference</strong>-->
            <!--                </th>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//table[@class='table table-condensed mt48']/tbody/tr/td[1]" position="before">-->
            <!--                <td>-->
            <!--                    <span t-field="move.product_id.default_code"/>-->
            <!--                </td>-->
            <!--            </xpath>-->
        </template>

        <template id="report_picking_inherit" inherit_id="stock.report_picking">
            <xpath expr="//table[@class='table table-condensed'][1]" position="after">
                <t t-set="source_loc_list" t-value="[]"/>
                <t t-set="destination_loc_list" t-value="[]"/>
                <t t-foreach="o.move_lines.sorted(key=lambda m: m.product_id.id)" t-as="move">
                    <t t-if="move.move_line_ids">
                        <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)" t-as="ml">
                            <t t-if="o.picking_type_id.code != 'incoming'">
                                <t t-set="location_id" t-value="ml.location_id.display_name"/>
                                <t t-set="source_loc_list" t-value="source_loc_list + [location_id]"/>
                            </t>
                            <t t-set="location_dest_id" t-value="ml.location_dest_id.display_name"/>
                            <t t-set="destination_loc_list" t-value="destination_loc_list + [location_dest_id]"/>
                        </t>
                    </t>
                </t>
                <div class="row">
                    <div class="col-xs-5 pull-left">
                        <table class="table table-condensed">
                            <tr>
                                <td class="text-center">
                                    <strong>Source</strong>
                                </td>
                                <td class="text-center">
                                    <strong>Destination</strong>

                                </td>
                            </tr>
                            <tr>
                                <td class="text-center">
                                    <span t-if="source_loc_list" t-esc="source_loc_list[0]"/>
                                </td>
                                <td class="text-center">
                                    <span t-if="destination_loc_list" t-esc="destination_loc_list[0]"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/thead/tr/th[1]" position="before">
                <!-- <t t-if="o.move_line_ids"> -->
                <th class="col-xs-3">
                    <strong>Part No</strong>
                </th>
                <!-- </t> -->
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/tbody/tr/td[1]" position="before">
                <!-- <t t-if="o.move_line_ids"> -->
                <td class="col-xs-3">
                    <span t-field="move.product_id.default_code"/>
                </td>
                <!-- </t> -->
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/thead/tr/th[2]" position="attributes">
                <attribute name="class">col-xs-10</attribute>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/tbody/tr/td[2]" position="attributes">
                <attribute name="class">col-xs-10</attribute>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/thead/tr/th[5]" position="replace">
                <th width="15%">
                    <strong>
                        NDP Cost
                    </strong>
                </th>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/thead/tr/th[6]" position="replace">
                <th width="20%">
                    <t t-if="has_serial_number">Lot/Serial Number</t>
                </th>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/thead/tr/th[7]" position="replace">
                <th width="20%" class="text-right">
                    <strong>
                        Tax
                    </strong>
                </th>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]/tbody/tr/td[5]//table" position="replace">
                <table width="100%">
                    <tr t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)" t-as="ml">
                        <td width="20%" padding-right="20px">
                            <span t-field="move.product_id.standard_price"/>
                        </td>
                        <td width="50%">
                            <t t-if="has_serial_number and ml.product_id.tracking != 'none'">
                                <div class="col-xs-12">
                                    <span t-field="ml.lot_id"/>
                                    <span t-if="not ml.lot_id" t-field="ml.lot_name"/>
                                    <br/>
                                    <span t-field="ml.qty_done"/>
                                    <t t-if="o.state!='done'">
                                        /
                                        <span t-field="ml.product_uom_qty"/>
                                    </t>
                                </div>
                            </t>
                            <div class="col-xs-12">

                            </div>
                        </td>
                        <t t-foreach="move.product_id.taxes_id" t-as="product_taxes">
                            <td width="30%" align="right" padding-left="5px">
                                <div class="text-center">
                                    <t t-esc="o.tax_percentage(product_taxes)"/>%
                                </div>
                            </td>
                        </t>
                    </tr>
                </table>
            </xpath>
            <xpath expr="//table[@class='table table-condensed'][2]" position="after">
                <div class="row" t-if="o.move_line_ids" style="page-break-inside: avoid;">
                    <div class="col-xs-4 pull-right">
                        <table class="table table-condensed">
                            <tr class="border-black">
                                <td>
                                    <strong>Subtotal</strong>
                                </td>
                                <td class="text-right">
                                    <t t-if="o.amount_untaxed">
                                        <span t-field="o.amount_untaxed"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-right">
                                    <t t-if="o.amount_tax">
                                        <span t-field="o.amount_tax"/>
                                    </t>
                                </td>
                            </tr>
                            <tr class="border-black">
                                <td>
                                    <strong>Total</strong>
                                </td>
                                <td class="text-right">
                                    <t t-if="o.amount_total">
                                        <span t-field="o.amount_total"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
