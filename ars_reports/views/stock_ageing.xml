<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- model.name tree view -->
        <record id="ars_stock_ageing_tree" model="ir.ui.view">
            <field name="name">stock_ageing_report</field>
            <field name="model">ars.stock.ageing.report</field>
            <field name="arch" type="xml">
                <tree string="Stock Ageing Report" create="false" import="false" delete="false">
                    <field name="default_code"/>
                    <field name="template_id"/>
                    <field name="parts_category"/>
                    <field name="name" invisible="1"/>
                    <field name="product_id" invisible="1"/>
                    <field name="location_id"/>
                    <field name="company_id" string="Dealer Name"/>
                    <!--                    <field name="computed_quantity" invisible="1"/>-->
                    <!--                    <field name="mrp_price"/>-->
                    <!--                    <field name="list_price"/>-->
                    <field name="quantity"/>
                    <field name="greater_730_stock_bal"/>
                    <field name="greater_730_stock_val"/>
                    <field name="days_730_stock_bal"/>
                    <field name="days_730_stock_val"/>
                    <field name="days_365_stock_bal"/>
                    <field name="days_365_stock_val"/>
                    <field name="days_180_stock_bal"/>
                    <field name="days_180_stock_val"/>
                    <field name="days_90_stock_bal"/>
                    <field name="days_90_stock_val"/>


                    <!--                    <field name="stock_value"/>-->
                    <!--                    <field name="days_90" invisible="0"/>-->
                    <!--                    <field name="days_180" invisible="0"/>-->
                    <!--                    <field name="days_365" invisible="0"/>-->
                    <!--                    <field name="days_730" invisible="0"/>-->
                    <!--                    <field name="greater_730" invisible="0"/>-->
                    <!--                    <field name="compute_days_90"/>-->
                    <!--                    <field name="days_90_value"/>-->
                    <!--                    <field name="compute_days_180"/>-->
                    <!--                    <field name="days_180_value"/>-->
                    <!--                    <field name="compute_days_365"/>-->
                    <!--                    <field name="days_365_value"/>-->
                    <!--                    <field name="compute_days_730"/>-->
                    <!--                    <field name="days_730_value"/>-->
                    <!--                    <field name="compute_greater_730"/>-->
                    <!--                    <field name="greater_730_value"/>-->
                </tree>
            </field>
        </record>

        <record id="ars_parts_stock_ageing_tree" model="ir.ui.view">
            <field name="name">parts_stock_ageing_report</field>
            <field name="model">ars.parts.stock.ageing.report</field>
            <field name="arch" type="xml">
                <tree string="Parts Stock Ageing Report" create="false" import="false" delete="false">
                    <field name="sap_no"/>
                    <field name="product_description"/>
                    <field name="location_id"/>
                    <field name="quantity"/>
                    <field name="ndp_without_gst"/>
                    <field name="total_ndp"/>
                    <field name="company_id"/>
                    <field name="last_received_date"/>
                    <field name="ageing_days"/>
                </tree>
            </field>
        </record>

        <record id="view_stock_aging_report" model="ir.ui.view">
            <field name="name">Stock Ageing Report</field>
            <field name="model">stock.ageing.report.wiz</field>
            <field name="arch" type="xml">
                <form string="Choose your date">
                    <group>
                        <group>
                            <field name="company_id" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="retrieve_stock_qty" string="Retrieve the Stock Quantities" type="object"
                                class="btn-primary"/>
                        <!--                        <button string="Cancel" class="btn-default" special="cancel"/>-->
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_parts_stock_aging_report" model="ir.ui.view">
            <field name="name">Parts Stock Ageing Report</field>
            <field name="model">parts.stock.ageing.report.wiz</field>
            <field name="arch" type="xml">
                <form string="">
                    <group>
                        <group>
                            <field name="company_id" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="retrieve_stock_qty" string="Retrieve the Parts Stock Quantities" type="object"
                                class="btn-primary"/>
                        <!--                        <button string="Cancel" class="btn-default" special="cancel"/>-->
                    </footer>
                </form>
            </field>
        </record>


        <record id="action_stock_quantity_history2" model="ir.actions.act_window">
            <field name="name">Stock Ageing Report</field>
            <field name="res_model">stock.ageing.report.wiz</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_reports.view_stock_aging_report"/>
            <field name="target">new</field>
            <field name="context">{'default_compute_at_date': 0, 'parts_inventory': True}</field>
        </record>

        <record id="action_parts_stock_quantity_history2" model="ir.actions.act_window">
            <field name="name">Parts Stock Ageing Report</field>
            <field name="res_model">parts.stock.ageing.report.wiz</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_reports.view_parts_stock_aging_report"/>
            <field name="target">new</field>
            <field name="context">{'default_compute_at_date': 0, 'parts_inventory': True}</field>
        </record>


        <record id="ars_stock_ageing_report_action" model="ir.actions.act_window">
            <field name="name">Stock Ageing Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ars.stock.ageing.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
        </record>

        <record id="ars_parts_stock_ageing_report_action" model="ir.actions.act_window">
            <field name="name">Parts Stock Ageing Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ars.parts.stock.ageing.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
        </record>


        <menuitem id="ars_menu_stock_ageing_report"
                  name="Stock Ageing Report"
                  action="action_stock_quantity_history2"
                  parent="ars_after_sales.menu_aftersales_reporting"
                  sequence="99"/>

        <menuitem id="ars_menu_parts_stock_ageing_report"
                  name="Parts Stock Ageing Report"
                  action="action_parts_stock_quantity_history2"
                  parent="ars_after_sales.menu_aftersales_reporting"
                  sequence="99"/>

    </data>
</odoo>

