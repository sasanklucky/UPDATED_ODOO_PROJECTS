<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tree view for "wholesale.report" -->
        <record id="view_wholesale_report_tree" model="ir.ui.view">
            <field name="name">view.wholesale_report.tree</field>
            <field name="model">wholesale.report</field>
            <field name="type">tree</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <tree string="wholesale_report_tree" create="false" delete="false" edit="false" default_order='id asc'>
                    <field name="sl_no" />
                    <field name="dealer_code" />
                    <field name="outlet" string="Dealer Name"/>
                    <field name="dealer_state" />
                    <field name="dealer_city" />
                    <field name="invoice_number" />
                    <field name="model_group" />
                    <field name="product_template_id" string="Product" />
                    <field name="product_id" string="Product Variant"/>
                    <field name="date_of_invoice" />
                    <field name="vin_no" string="VIN"/>
                    <field name="color" string="Attributes"/>
                    <field name="basic_price" />
                    <field name="gst" />
                    <field name="total" />
                    <field name="motor_number" />
                    <field name="description" />
                    <field name="vendor" />
                    <field name="vendor_reference_no" />
                </tree>
            </field>
        </record>
        
        <!-- Search view for "wholesale.report" -->
        <record id="view_wholesale_report_search" model="ir.ui.view">
            <field name="name">view.wholesale_report.search</field>
            <field name="model">wholesale.report</field>
            <field name="type">search</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <search string="wholesale_report_search">
                    <field name="outlet" />
                </search>
            </field>
        </record>
        
        <!-- Main window action for "wholesale.report" -->
        <record id="action_wholesale_report_act_window" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Wholesale Report</field>
            <field name="res_model">wholesale.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
            <field name="target">current</field>
            <field name="domain">[]</field>
            <field name="context">\{}</field>
            <field name="search_view_id" ref="view_wholesale_report_search" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Wholesale Report
                </p>
            </field>
        </record>

        <record id="view_wholesale_report_report_wizard" model="ir.ui.view">
            <field name="name">Wholesale Report</field>
            <field name="model">wholesale.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose your Ro Closed From Date to date">
                    <group>
                        <span><h3>Please select the dealers</h3></span>
                            <field name="company_id" widget="many2many_tags"/>
                        <group>
                            <span><b>From</b></span>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <span><b>To</b></span>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="wholesale_report_qty" string="Wholesale Report" type="object"
                                class="btn-primary"/>
                        <!--                        <button string="Cancel" class="btn-default" special="cancel"/>-->
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wholesale_report_wizard" model="ir.actions.act_window">
            <field name="name">wholesale Report Wizard</field>
            <field name="res_model">wholesale.report.wizard</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_reports.view_wholesale_report_report_wizard"/>
            <field name="target">new</field>
        </record>

        
        <!-- Main menu for "wholesale.report" -->
        <record id="menu_wholesale_report" model="ir.ui.menu" >
            <field name="name">Wholesale Report</field>
            <!-- <field name="sequence" eval="10" /> -->
            <field name="action" ref="action_wholesale_report_wizard" />
            <field name="parent_id" ref="account.account_reports_management_menu" />
        </record>
        

    </data>
</odoo>