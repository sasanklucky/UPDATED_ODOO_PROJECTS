<odoo>
    <data noupdate="0">
        <record id="shell_location_comp_rule" model="ir.rule">
            <field name="name">Shelf Location multi-company</field>
            <field name="model_id" ref="model_shell_location"/>
            <field name="global" eval="True"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'child_of', [user.company_id.id])]
            </field>
        </record>
    </data>
