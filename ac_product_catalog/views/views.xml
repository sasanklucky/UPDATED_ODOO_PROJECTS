<odoo>
    <data>
        <record model="ir.ui.view" id="ac_product_catalog_list">
            <field name="name">ac_product_catalog list</field>
            <field name="model">product.catalog</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="ac_product_catalog_form">
            <field name="name">ac_product_catalog list</field>
            <field name="model">product.catalog</field>
            <field name="arch" type="xml">
                <form>
                    <group col="4" string="Product Catalog">
                        <field name="name"/>
                        <field name="code" attrs="{'readonly': [('code','!=',False)]}"/>
                        <field name="type"/>
                    </group>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ac_product_catalog_action_window">
            <field name="name">Product Catalog Window</field>
            <field name="res_model">product.catalog</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Product Catalog" id="ac_product_catalog_menu" parent="sale.prod_config_main"
                  action="ac_product_catalog.ac_product_catalog_action_window"/>
    </data>
</odoo>