<odoo>
    <data>

        <record id="ac_product_catalog_invoice_form_inherit" model="ir.ui.view">
            <field name="name">invoice.supplier.cancel.form.inherit</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_supplier_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field name="ars_type" groups="base.group_no_one"/>
                </field>
            </field>
        </record>

        <record id="ac_product_catalog_invoice_form_sale_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field name="ars_invoice_type" groups="base.group_no_one"/>
                </field>
            </field>
        </record>

    </data>
</odoo>

