<odoo>
    <data noupdate="0">

        <record id="ac_product_catalog_invoice_form_inherit" model="ir.ui.view">
            <field name="name">invoice.supplier.cancel.form.inherit</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_supplier_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field name="ars_type" groups="base.group_no_one"/>
                </field>
            </field>
        </record>

        <record id="ac_product_catalog_invoice_form_sale_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field name="ars_invoice_type" groups="base.group_no_one" attrs="{'readonly':[('state','not in',['draft'])]}"/>
                </field>
            </field>
        </record>

        <record id="ac_product_catalog_invoice_form_after_sale_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="ars_after_sales.invoice_form_inherit"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <field name="ars_invoice_type" groups="base.group_no_one" attrs="{'readonly':[('state','not in',['draft'])]}"/>
                </field>
            </field>
        </record>

        <record id="ars_type_view_account_journal_form" model="ir.ui.view">
            <field name="name">ars.account.journal.form.inherited</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="before">
                    <field name="ars_type"/>
                </xpath>
            </field>
        </record>

        <record id="action_invoice_parts_tree1" model="ir.actions.act_window">
            <field name="name">Parts Invoices</field>
            <field name="res_model">account.invoice</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
            <field name="domain">
                [('type','=','out_invoice'),('team_id.team_type','=','after_sales'),('ars_invoice_type','=','parts')]
            </field>
            <field name="context">{'type':'out_invoice', 'journal_type':
                'sale','default_ars_invoice_type':'parts'}
            </field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('account.invoice_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('account.invoice_form')})]"/>
        </record>

        <record id="action_invoice_out_refund_parts" model="ir.actions.act_window">
            <field name="name">Customer Credit Notes</field>
            <field name="res_model">account.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">
                [('type','=','out_refund'),('team_id.team_type','=','after_sales'),('ars_invoice_type','=','parts')]
            </field>
            <field name="context">{'default_type': 'out_refund', 'type': 'out_refund', 'journal_type': 'sale'}
            </field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('account.invoice_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('account.invoice_form')})]"/>
        </record>

        <record id="product_product_action_sellable_parts" model="ir.actions.act_window">
            <field name="name">Sellable Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="view_type">form</field>
            <field name="domain">
                ['|',('catalog_type.name','=','Parts'),('catalog_type.name','=','Accessories')]
            </field>
            <field name="context">{'search_default_filter_to_sell': 1}</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('account.product_product_view_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_template_only_form_view')})]"/>
        </record>


    </data>
</odoo>

