        </record>
        <record id="freezer_page" model="website.page">
            <field name="name">Freezer</field>
            <field name="website_published">True</field>
            <field name="url">/free_home</field>
            <field name="view_id" ref="freezer_home"/>
        </record>
        <record id="frond_end" model="website.menu">
            <field name="page_id" ref="freezer_page"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">99</field>
