<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="invoice_sync_form_inherit" model="ir.ui.view">
            <field name="name">account.invoice.sync.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group/group/field[@name='date_invoice']"
                       position="before">
                       <field name="sync_invoice" readonly='1'/>
                       <field name="child_invoice_ref" readonly='1'/>
                       <field name="child_invoice_id_ref" readonly='1'/>
                       <field name="child_db" readonly='1'/>
                       <!-- <field name="parent_db" readonly='1'/> -->
                       <!-- <field name="test_css" invisible='1'/> -->
                </xpath>
                <xpath expr="//form/header"
                       position="inside">
                       <field name="hide_sync" invisible='1'/>
                       <button class="oe_highlight" name="call_invoice_sync" 
                        string="Send to NSC" type="object" attrs="{'invisible': [('hide_sync','=',True)]}"
                        />
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string='Log'>
                        <group>
                            <field name="invoice_sync_log_ids" readonly='1' >
                                <tree string="log_details" readonly='1' >
                                    <field name="invoice_record" readonly='1' />
                                    <field name="invoice_sequence" readonly='1' />
                                    <field name="payload" readonly='1' />
                                    <field name="status" readonly='1' />
                                    <field name="sync_message" readonly='1' />
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    <record id="invoice_sync_tree_inherit" model="ir.ui.view">
            <field name="name">account.invoice.sync.tree</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']"
                       position="after">
                       <field name="sync_invoice" readonly='1'/>
                       <field name="child_invoice_ref" readonly='1'/>
                       <field name="child_invoice_id_ref" readonly='1'/>
                       <field name="child_db" readonly='1'/>
                       <!-- <field name="parent_db" readonly='1'/> -->
                       <!-- <field name="test_css" invisible='1'/> -->
                </xpath>
                <xpath expr="//tree" position="attributes">
                     <attribute name="decoration-success">sync_invoice==True</attribute>
                     <attribute name="decoration-danger">sync_invoice==False</attribute>
                     <!-- <attribute name="decoration-success">apr_action == 'approved' or apr_action == 'approved' and invoice_status == 'to invoice' </attribute> -->
                    <!-- <attribute name="decoration-danger">apr_action == 'reject' or apr_action  == 'reject' and invoice_status == 'to invoice'</attribute> -->
                </xpath>
            </field>
        </record>
        
</odoo>