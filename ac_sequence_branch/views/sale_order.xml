<odoo>
    <record id="view_sequence_form_inherit_branch" model="ir.ui.view">
        <field name="name">ir.sequence.form.inherit.branch</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="branch"/>
            </xpath>
        </field>
    </record>
</odoo>
