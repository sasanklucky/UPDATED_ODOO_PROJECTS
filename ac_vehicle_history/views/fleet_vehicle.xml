<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id='ac_ars_vehicle_history_vehicle_form_inherited' model='ir.ui.view'>
        <field name="name">ac_ars_vehicle_history_view_form_inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="ars_vehicle_sales.ars_vehicle_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[last()]" position="inside">
                <page string="Wholesale History">
                    <field name="wholesale_ids" readonly="1">
                        <tree editable="False" create="0" delete="0">
                            <field name="dealer_name" string="Dealer Name"/>
                            <field name="so_number" string="SO Number"/>
                            <field name="so_id" string="SO ID" invisible="1"/>
                            <field name="delivery_date" string="Delivery Date"/>
                            <field name="invoice_number" string="Invoice Number"/>
                            <field name="invoice_id" string="Invoice ID" invisible="1"/>
                            <field name="po_number" string="PO Reference"/>
                            <field name="transfer_type" string="Transfer Type"/>
                            <field name="dealer_code" string="Dealer Code"/>
                            <field name="dealer_master_id" string="Dealer Setup"/>
                        </tree>
                    </field>
                </page>

            </xpath>
            <xpath expr="//field[@name='transmission']" position="after">
                <field name="service_type_sequence" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='location']" position="after">
                <field name="po_ref" groups="base.group_no_one"/>
            </xpath>



        </field>
    </record>
</odoo>