<odoo>
    <data>
         <record id="ac_service_type_list_inherited" model="ir.ui.view">
            <field name="name">service.type.list.inherit</field>
            <field name="model">service.type</field>
            <field name="inherit_id" ref="ars_after_sales.ac_service_type_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sequence"/>
                    <field name="code" required="1"/>
                </xpath>
            </field>
        </record>
    </data>


</odoo>