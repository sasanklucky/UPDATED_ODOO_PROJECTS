<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="paperformat_service_hist" model="report.paperformat">
            <field name="name">Service History</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">18</field>
            <field name="margin_left">14</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    <report
            id="sale_action_service_history_invoice"
            string="Service History PDF"
            model="fleet.vehicle"
            report_type="qweb-pdf"
            file="ac_vehicle_history.report_vehicle_service_hist"
            name="ac_vehicle_history.report_vehicle_service_hist"
            paperformat="ac_vehicle_history.paperformat_service_hist"
            print_report_name="'Service History - %s' % (object.name)"

    />

    <template id="report_vehicle_service_hist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ac_vehicle_history.vehicle_service_hist_template"/>
<!--                 <t t-call="ac_vehicle_history.detailed_service_hist_template"/>-->
            </t>
        </t>
    </template>


</odoo>