                    <!--</t>-->
                    <div class="table-responsive mobile-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><span><a href="#" id='select_tech_chkbx'>Select All</a></span></th>
                                    <th>Task Title</th>
                                    <th>Resources</th>
                                    <!--<th>Stage</th>-->
                                    <th>Stage</th>
                                    <th>Break Reason</th>
                                    <!--<th>Break Type</th>-->
                                    <th>Start time</th>
                                   <!-- <th>Working Time Progress (%)</th> -->
                                    <th>End time</th>
                                    <th style="display:none;">Bay</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="tasks" t-as="o">
                                    <tr>

                                        <td>
                                            <!--<t t-foreach="show_task" t-as="st">-->


                                            <!--<t t-if="st.id == o.id">-->

                                                    <input type="checkbox" id="stage_chkbx" t-att-name="'%s' % (o.id)" t-att-value="'%s' % (o.id)" />
                                                <!--</t>-->
                                            <!--</t>-->
                                        </td>
                                        <td><t t-esc="o.name"/></td>
                                        <td>
                                           <!--<t t-set="p" t-value="0"/>
                                            <t t-set="q" t-value="''"/>-->
                                            <t t-set="sheet_name" t-value="''"/>
                                            <t t-foreach="o.timesheet_ids" t-as="sheet">
                                                <t t-if="sheet.resource_type == tech_categ">
                                                    <t t-if="sheet.entry_type == 'plan'">
                                                        <t t-set="sheet_name" t-value="sheet.resource_name.name"/>
                                                    </t>
                                                </t>
                                            </t>
                                            <t t-esc="sheet_name"/>
                                                <!--<t t-if="p > 0">

                                                    <t t-set="q" t-value="(q+','+resources.name)"/>
                                                </t>
                                                <t t-set="p" t-value="p+1"/>-->
                                            <!--</t>-->
                                            <!--<t t-esc="q" />-->
                                        </td>
                                        <!--<td>
                                            <t t-esc="o.stage_id.sequence"/>
                                        </td>-->
                                        <td>
                                            <t t-esc="o.stage_id.stage_display_name"/>
                                        </td>

                                        <td><t t-esc="o.break_reason_fn"/></td>
                                        <!--<td>
                                            &lt;!&ndash;<t t-esc="'Tea Break' if o.break_type == 'tea' else 'Lunch Break' if o.break_type == 'lunch' else 'Other Break' if o.break_type == 'others' else o.break_type"/>&ndash;&gt;
                                        </td>-->
                                        <td><t t-esc="o.start_datetime_fn"/></td>

                                        <td><t t-esc="o.end_datetime_fn"/></td>
                                        <td style="display:none;"><!--<t t-esc="o.task_bay.name"/>--></td>
                                        <td style="display:none;"><!--<t t-esc="o.task_start_multech()"/>--></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </template>
</odoo>