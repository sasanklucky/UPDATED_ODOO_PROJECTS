    <record id="view_sale_order_line_custom_form" model="ir.ui.view">
        <field name="name">sale.order.line.custom.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Custom Sale Order Line">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_sale_order_line_custom" model="ir.actions.act_window">
        <field name="name">Sale Order Line Custom</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ac_master_data_restriction.view_sale_order_line_custom_form"/>
        <field name="target">new</field>
    </record>


</data>
</odoo>