<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ars_groups_config_menu_view_id" model="ir.ui.view">
            <field name="name">ars_config_inherited</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="ars_after_sales.res_config_ars_settings"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invoice_ars_setup']" position="after">
                    <h2>ARS Master Data Restriction</h2>
                    <div class="row mt16 o_settings_container" id="ars_settings">
                        <!--  Master Data Restriction  -->
                        <div class="col-xs-12 col-md-6 o_setting_box" id="ars_master_data_restriction">
                            <div class="o_setting_right_pane">
                                <label string="General Sales"/>
                                <field name="gsale_restrict_master_data"/>
                                <field name="gsale_res_gr_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="ars_master_data_restriction">
                            <div class="o_setting_right_pane">
                                <label string="After Sales"/>
                                <field name="asale_restrict_master_data"/>
                                <field name="asale_res_gr_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="ars_master_data_restriction1">
                            <div class="o_setting_right_pane">
                                <label string="Vehicle Sales"/>
                                <field name="vsale_restrict_master_data"/>
                                <field name="vsale_res_gr_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="ars_master_data_restriction2">
                            <div class="o_setting_right_pane">
                                <label string="Others"/>
                                <field name="other_restrict_master_data"/>
                                <field name="others_res_gr_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </div>
                    <h2>CRM Lead Restriction based On Model</h2>
                    <div class="row mt16 o_settings_container" id="ars_setting2">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="ars_master_data_restriction3">
                            <div class="text-muted">
                                Please select the model for which you want to configure the editing restrictions based
                                on the modification period
                            </div>
                            <div class="o_setting_left_pane">
                                <field name="restrict_crm_lead"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="Model based restriction on CRM"/>
                                <!-- <field name="restrict_crm_lead"/>-->
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container" id="ars_setting2">
                        <div class="col-xs-12 col-md-6 o_setting_box"
                             id="ars_master_data_restriction3"
                             attrs="{'invisible': [('restrict_crm_lead','=', False)]}">
                            <div class="o_setting_left_pane"/>
                            <label string="Model"/>
                            <div class="o_setting_right_pane">
                                <field name="model_ids" widget="many2many_tags"
                                       domain="[('catalog_type.name', '=', 'Vehicle')]"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box"
                             id="ars_master_data_restriction3"
                             attrs="{'invisible': [('restrict_crm_lead','=', False)]}">
                            <div class="o_setting_left_pane"/>
                            <label string="Specified Date"/>
                            <div class="o_setting_right_pane">
                                <field name="till_date"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
