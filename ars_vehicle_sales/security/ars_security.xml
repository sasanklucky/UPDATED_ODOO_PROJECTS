<?xml version="1.0" ?>
<odoo>
    <record model="ir.module.category" id="module_category_ars">
        <field name="name">ARS</field>
        <field name="sequence">100</field>
    </record>
    <record id="group_ars_vehicle_admin" model="res.groups">
        <field name="name">Vehicle Admin</field>
        <field name="category_id" ref="module_category_ars"/>
    </record>

    <data noupdate="1">
        <record id="website.website_page_rule_public" model="ir.rule">
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        </record>
    </data>
    <data noupdate="0">
        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'crm'), ('name', 'in', ['crm_rule_all_lead','crm_rule_personal_lead'])]"/>
            </function>
            <value eval="{'noupdate': False}" />
        </function>
        <record id="crm.crm_rule_all_lead" model="ir.rule">
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        </record>
        <record id="crm.crm_rule_personal_lead" model="ir.rule">
            <field name="domain_force">['|',('user_id','=',False),('user_id','=',user.id),('company_id','=',user.company_id.id)]</field>
        </record>
    </data>
</odoo>