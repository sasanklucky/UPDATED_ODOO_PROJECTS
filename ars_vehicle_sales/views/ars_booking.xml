<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_sale_order_form_inherit_booking" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.booking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!--            <xpath expr="//div[@class='oe_button_box']" position="inside">-->
            <!--                <button type="object" name="action_view_booking_amount"-->
            <!--                        string="Booking Amount"-->
            <!--                        icon="fa-money"-->
            <!--                        class="oe_stat_button"-->
            <!--                        attrs="{'invisible': [('state', '!=', 'sale')]}">-->
            <!--                        <field name="booking_amount_total_value" widget="statinfo"/>-->
            <!--                </button>-->
            <!--            </xpath>-->
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_booking_amount"
                        icon="fa-money"
                        attrs="{'invisible': [('state', '!=', 'sale')]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="booking_amount_total_value"/>
                        </span>
                        <span class="o_stat_text">Booking Amount</span>
                    </div>
                </button>
            </xpath>


            <!--            <xpath expr="//div[@class='oe_button_box']/button[@name='action_view_delivery']" position="after">-->
            <!--                <button type="object" name="action_view_booking_amount"-->
            <!--                        string="Booking Amount"-->
            <!--                        icon="fa-money"-->
            <!--                        class="oe_stat_button">-->
            <!--                </button>-->
            <!--            </xpath>-->
        </field>
    </record>

    <record id="view_booking_amount_form" model="ir.ui.view">
        <field name="name">booking.amount.form</field>
        <field name="model">booking.amount</field>
        <field name="arch" type="xml">
            <form string="Booking Amount" create="false">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="cancel_booking" type="object" string="Cancel" class="oe_highlight"
                            attrs="{'invisible': [('status', '=', 'cancel')]}"/>

                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_name" options="{'no_create': True, 'no_open': True}"
                                   attrs="{'readonly': [('status', '=', 'cancel')]}" readonly="1"/>
                            <field name="date" attrs="{'readonly': [('status', '=', 'cancel')]}" readonly="1"/>
                            <field name="booking_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                                   attrs="{'readonly': [('status', '=', 'cancel')]}"/>
                            <field name="remarks" attrs="{'readonly': [('status', '=', 'cancel')]}"/>
                            <!--                            <field name="product_template_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('status', '=', 'cancel')]}" readonly="1"/>-->
                            <!--                            <field name="product_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('status', '=', 'cancel')]}" readonly="1"/>-->
                        </group>

                        <!--                        <group>-->
                        <!--                            <field name="journal_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('status', '=', 'cancel')]}" invisible="1"/>-->
                        <!--                            <field name="journal_type" invisible="1"/>-->
                        <!--                            <field name="bank_id" attrs="{'invisible': [('journal_type', '!=', 'bank')]}" options="{'no_create': True, 'no_open': True}" invisible="1"/>-->

                        <!--                            <field name="total_booking_amount" widget='monetary' options="{'currency_field': 'currency_id'}" readonly="1" />-->
                        <!--                            <field name="booking_amount" widget='monetary' options="{'currency_field': 'currency_id'}" attrs="{'readonly': [('status', '=', 'cancel')]}" />-->
                        <!--                            <field name="remarks" attrs="{'readonly': [('status', '=', 'cancel')]}"/>-->

                        <!--                        </group>-->
                    </group>

                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_booking_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                               readonly="1" invisible="1"/>
                        <field name="booking_amount" widget='monetary' options="{'currency_field': 'currency_id'}"
                               attrs="{'readonly': [('status', '=', 'cancel')]}" invisible="1"/>
                        <!--                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">-->
                        <!--                            <label for="remaining_booking_amount"/>-->
                        <!--                        </div>-->
                        <field name="remaining_booking_amount" nolabel="1" class="oe_subtotal_footer_separator"
                               widget='monetary' options="{'currency_field': 'currency_id'}" invisible="1"/>
                    </group>
                </sheet>


                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>


            </form>

        </field>
    </record>

    <record id="view_booking_amount_tree" model="ir.ui.view">
        <field name="name">booking.amount.tree</field>
        <field name="model">booking.amount</field>
        <field name="arch" type="xml">
            <tree string="Booking Amount" create="true" edit="false" decoration-muted="status == 'cancel'">
                <field name="customer_name"/>
                <field name="date"/>
                <field name="booking_amount"/>
                <!--                <field name="product_template_id"/>-->
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_booking_amount_list" model="ir.actions.act_window">
        <field name="name">Booking Amount</field>
        <field name="res_model">booking.amount</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_booking_amount_tree"/>
        <field name="target">current</field>
    </record>

</odoo>
