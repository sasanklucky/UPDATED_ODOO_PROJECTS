                                <tr class="active">
                                    <h3 style="margin-left:0px;">
                                        <strong>Quotation # </strong>
                                        <strong t-field="doc.name"/>
                                    </h3>
                                    <td>
                                        <span t-if="ord_lin.product_id.image_medium" t-field="ord_lin.product_id.image_medium" t-options='{"widget": "image", "class": "tech_img", "alt-field": "name", "zoom": "image", "style":"width: 450px;height: 300px;" }'/>
