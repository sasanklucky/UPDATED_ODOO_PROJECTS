                                    <div>
                                        <strong>Seating Capacity:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.seating_capacity"/>
                                    </div>
                                </tr>
                            </t>
                        </div>
                        <div class="col-xs-6">
