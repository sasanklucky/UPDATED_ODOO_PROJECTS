                                        <t t-if="ord_lin.product_id.centre_locking == true">
                                            <img src="/ars_vehicle_sales/static/src/img/true_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                        <t t-if="ord_lin.product_id.centre_locking == false">
                                            <img src="/ars_vehicle_sales/static/src/img/false_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                    </div>
                                </tr>
                            </t>
