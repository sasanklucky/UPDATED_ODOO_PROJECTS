                                        </div>
                                        <div>
                                            <span t-field="doc.amount_total" style="font-weight: bold; font-size: 20px;"/>
                                        </div>
                                        <div>
                                            <span>On Road Price (Inc GST)</span>
                                        </div>
                                    </div>


