                                        <p style="font-weight: bold; margin-left:45px; margin-top:-8px; font-style: italic;" t-field="ord_lin.product_id.engine_capacity"></p>
                                    </div>

                                    <div class="col-xs-4">
                                        <strong>
                                            <img src="/ars_vehicle_sales/static/src/img/color.png" title="Color" width="42px"/>
                                            Color
