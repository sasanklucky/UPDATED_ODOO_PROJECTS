
<odoo>

<template id="ars_portal_order_page" name="Sales Order">
      <t t-call="portal.portal_layout">
        <t t-set="sales_order" t-value="order"/> <!-- rename to ensure breadcrumb compatibility (differentiate with purchase orders) -->
        <t t-set="invoices" t-value="[i for i in order.invoice_ids if i.state not in ['draft', 'cancel']]"/>
        <t t-set="invoices_amount" t-value="sum(i.amount_total for i in invoices)"/>
        <div id="optional_placeholder"></div>
        <div class="container">
          <div class="panel panel-default">
            <div class="panel-heading">
              <div class="row">

                  <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">

                    <div class="col-xs-12">
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <a target="_blank" t-att-href="'/my/orders/pdf/%s?%s' % (order.id, keep_query())" class="ml8 pull-right mt4 mr8" title="Download">
                                    <i class="fa fa-download fa-2x" aria-hidden="true"/>
                                </a>
                                <tr class="active">
                                    <h3 style="margin-left:0px;">
                                        <strong>Quotation # </strong>
                                        <strong t-field="order.name"/>
                                    </h3>
                                    <td>
                                        <span t-if="ord_lin.product_id.image_medium" t-field="ord_lin.product_id.image_medium"
                                              t-options='{"widget": "image", "class": "tech_img", "alt-field": "name", "zoom": "image",
                                              "style":"width: 350px;height: 200px;" }'/>
                                    </td>
                                </tr>
                            </t>
                        </div>

                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <div style="margin-top: 50px;margin-left: 80px;">
                                            <strong style="font-weight: bold; font-size: 20px;">Customer Details:</strong>
                                            <span t-field="order.partner_id" t-options='{"widget": "contact", "fields": ["name"]}' />
                                            <span t-field="order.partner_id" t-options='{"widget": "contact", "fields": ["mobile", "email"], "no_marker": True}' />
                                        </div>
                                    </div>
                                    <div style="margin-top: 42px;margin-left: 80px;">
                                        <div>
                                            <span t-field="ord_lin.product_id" style="font-weight: bold; font-size: 20px;"/>
                                        </div>
                                        <div>
                                            <span t-field="order.amount_total" style="font-weight: bold; font-size: 20px;"/>
                                        </div>
                                        <div>
                                            <span>On Road Price (Inc GST)</span>
                                        </div>
                                    </div>
                                </tr>
                            </t>
                        </div>
                    </div>

                    <div class="col-xs-12" style="border-bottom-style:solid !important; border-width:2px !important;margin-top:26px;">
                    </div>

                    <div class="col-xs-12" style="margin-top:0px;">
                        <div class="col-xs-3">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div style="margin-top:10px;">
                                        <strong>
                                            <img src="/ars_vehicle_sales/static/src/img/fuel.png" title="Fuel" width="50px"/>
                                            Fuel Type
                                            <p t-field="ord_lin.product_id.fuel_type" style="font-weight: bold; margin-left:53px; margin-top:-16px; font-style: italic;"/>
                                        </strong>
                                    </div>
                                </tr>
                            </t>
                        </div>
                        <div class="col-xs-3">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div style="margin-top:10px;">
                                        <strong>
                                            <img src="/ars_vehicle_sales/static/src/img/color.png" title="Fuel" width="50px"/>
                                            Color
                                            <t t-foreach="ord_lin.product_id.attribute_value_ids" t-as="at">
                                                <t t-if="at.attribute_id.name == 'color'">
                                                    <p style="font-weight: bold; margin-left:53px; margin-top:-16px; font-style: italic;"  t-esc="at.name"></p>
                                                </t>
                                            </t>
                                        </strong>
                                    </div>
                                </tr>
                            </t>
                        </div>
                    </div>

                    <div class="col-xs-12" style="margin-top:2px;">
                        <span style="background-color: white; position: relative; top: 15px; padding: 9px 10px; z-index:999;">
                            <img src="/ars_vehicle_sales/static/src/img/design_dimen.png" title="Fuel" width="27px"/>
                            <strong>Design &amp; Dimensions</strong>
                        </span>
                    </div>
                    <div class="col-xs-12" style="border-style:solid !important; border-width:2px !important; border-radius: 5px; !important; height: 70px; padding:24px 10px;">
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>Car Type:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.car_type"/>
                                    </div>
                                    <div>
                                        <strong>Seating Capacity:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.seating_capacity"/>
                                    </div>
                                </tr>
                            </t>
                        </div>
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>No of Doors:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.no_of_doors"/>
                                    </div>
                                </tr>
                            </t>
                        </div>
                    </div>

                    <div class="col-xs-12" style="margin-top:17px;">
                        <span style="background-color: white; position: relative; top: 15px; padding: 9px 10px; z-index:999;">
                            <img src="/ars_vehicle_sales/static/src/img/speed_perf.png" title="Fuel" width="27px"/>
                            <strong>Power &amp; Performance</strong>
                        </span>
                    </div>
                    <div class="col-xs-12" style="border-style:solid !important; border-width:2px !important; border-radius: 5px; !important; height: 70px; padding:24px 10px;">
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>Transmission:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.transmission_type_code"/>
                                    </div>
                                    <div>
                                        <strong>City Mileage:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.city_mileage"/>
                                    </div>
                                </tr>
                            </t>
                        </div>
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>Engine Capacity:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.engine_capacity"/>
                                    </div>
                                    <div>
                                        <strong>Highway Mileage:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.highway_mileage"/>
                                    </div>
                                </tr>
                            </t>
                        </div>
                    </div>

                    <div class="col-xs-12" style="margin-top:17px;">
                        <span style="background-color: white; position: relative; top: 15px; padding: 9px 10px; z-index:999;">
                            <img src="/ars_vehicle_sales/static/src/img/comfort_con.png" title="Fuel" width="27px"/>
                            <strong>Comfort &amp; Convenience</strong>
                        </span>
                    </div>
                    <div class="col-xs-12" style="border-style:solid !important; border-width:2px !important; border-radius: 5px; !important; height: 91px; padding:24px 10px;">
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>Power Steering:</strong>
                                        <t t-if="ord_lin.product_id.power_steering == true">
                                            <img src="/ars_vehicle_sales/static/src/img/true_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                        <t t-if="ord_lin.product_id.power_steering == false">
                                            <img src="/ars_vehicle_sales/static/src/img/false_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                    </div>
                                    <div>
                                        <strong>A/C:</strong>
                                        <t t-if="ord_lin.product_id.ac == true">
                                            <img src="/ars_vehicle_sales/static/src/img/true_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                        <t t-if="ord_lin.product_id.ac == false">
                                            <img src="/ars_vehicle_sales/static/src/img/false_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                    </div>
                                    <div>
                                        <strong>Steering Adjustment:</strong>
                                        <t t-if="ord_lin.product_id.steering_adjustment == true">
                                            <img src="/ars_vehicle_sales/static/src/img/true_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                        <t t-if="ord_lin.product_id.steering_adjustment == false">
                                            <img src="/ars_vehicle_sales/static/src/img/false_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                    </div>
                                </tr>
                            </t>
                        </div>
                        <div class="col-xs-6">
                            <t t-foreach="order.order_line" t-as="ord_lin">
                                <tr class="active">
                                    <div>
                                        <strong>Power Windows:</strong>
                                        <span style="font-style: italic;" t-field="ord_lin.product_id.power_window"/>
                                    </div>
                                    <div>
                                        <strong>Central Locking:</strong>
                                        <t t-if="ord_lin.product_id.centre_locking == true">
                                            <img src="/ars_vehicle_sales/static/src/img/true_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                        <t t-if="ord_lin.product_id.centre_locking == false">
                                            <img src="/ars_vehicle_sales/static/src/img/false_arrow.png" title="Fuel" width="18px"/>
                                        </t>
                                    </div>
                                </tr>
                            </t>
                        </div>
                    </div>

                    <div class="col-xs-12" style="margin-top:17px;">
                        <strong style="background-color: white; position: relative; top: 15px; padding: 9px 10px; z-index:999;">Description</strong>
                    </div>
                    <div class="col-xs-12" style="border-style:solid !important; border-width:2px !important; border-radius: 5px; !important; height: auto; padding:24px 10px;">
                        <t t-foreach="order.order_line" t-as="ord_lin">
                            <tr class="active">
                                <div>
                                    <span style="font-style: italic;" t-field="ord_lin.product_id.description_sale"/>
                                </div>
                            </tr>
                        </t>
                    </div>
                  </t>

              </div>
            </div>
          </div>
        </div>
          <div class="oe_structure mb32"/>
      </t>
</template>


