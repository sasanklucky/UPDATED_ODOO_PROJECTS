<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_production_lot_form_ars_inherit" model="ir.ui.view">
            <field name="name">stock.production.lot.inherit.form</field>
            <field name="model">stock.production.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="product_catalog" readonly="True"/>
                    <field name="motor_number" attrs="{'required': [('product_catalog', '=', 'Vehicle')]}"/>
                </field>
            </field>
        </record>

        <record id="view_stock_move_line_operation_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='lot_id']" position="replace">
                    <!--                    ,('check_new_lotno','!=',True)-->
                    <field name="lot_id" string="VIN" options="{'no_quick_create': True, 'no_create_edit' : True}"
                           invisible="not context.get('show_lots_m2o')"
                           groups="stock.group_production_lot" domain="[('product_id', '=', parent.product_id)]"
                           context="{'default_product_id': parent.product_id, 'active_picking_id': picking_id}"/>
                </xpath>
                <field name="lot_id" position="after">
                    <field name="motor_number"/>
                </field>

            </field>
        </record>

        <!--        Menu for vehicle in a product Catalog-->

        <menuitem name="Vehicle" id="menu_vehicle_sales" action="fleet.fleet_vehicle_action"
                  parent="sale.product_menu_catalog" sequence="1"/>

    </data>
</odoo>