     <record id="crm_lost_reason_action_main" model="ir.actions.act_window">
            <field name="name">Lost Reasons Child</field>
            <field name="res_model">crm.lost.reason.child</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Click to define a new lost reason.
              </p><p>
                Use lost reasons to explain why an opportunity is lost.
              </p><p>
                Some examples of lost reasons: "We don't have people/skill", "Price too high"
              </p>
            </field>
        </record>

    <record id="ars_crm_lead_lost_view_form_child" model="ir.ui.view">
        <field name="name">crm.lead.lost.form</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form"/>
        <field name="arch" type="xml">
            <field name="lost_reason_id" position="before">
                <field name="check_sales_ids" readonly="1" nolabel="1"/>
            </field>
            <field name="lost_reason_id" position="after">
                <field name="child_lost_reason" domain="[('parent_lost_reason','=',lost_reason_id )]"
                       options="{'no_create': True, 'no_open': True}" required="1" string="Sub Lost Reason"/>
            </field>
            <xpath expr="//field[@name='lost_reason_id']" position="attributes">
                <attribute name="options">{'no_create':True,'no_edit':True}</attribute>
                <attribute name="required">1</attribute>
                <attribute name="string">Main Lost Reason</attribute>
            </xpath>

        </field>
    </record>

    <menuitem
            id="menu_crm_lost_reason_main"
            action="crm_lost_reason_action_main"
            parent="crm.menu_crm_config_lead"
            sequence="6"
            groups="base.group_system"/>

</odoo>