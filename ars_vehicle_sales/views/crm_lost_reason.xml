<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="crm_lost_reason_child_view_form" model="ir.ui.view">
        <field name="name">crm.lost.reason.child.form</field>
        <field name="model">crm.lost.reason.child</field>
        <field name="arch" type="xml">
            <form string="Channel">
                <group>
                    <field name="name" required="1"/>
                    <field name="parent_lost_reason" options="{'no_open':True,'no_create':True}" required="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="crm_lost_reason_child_view_tree" model="ir.ui.view">
        <field name="name">crm.lost.reason.child.form</field>
        <field name="model">crm.lost.reason.child</field>
        <field name="arch" type="xml">
            <tree string="Lost Reason Child">
                <field name="name"/>
                <field name="parent_lost_reason"/>
            </tree>
        </field>
    </record>

