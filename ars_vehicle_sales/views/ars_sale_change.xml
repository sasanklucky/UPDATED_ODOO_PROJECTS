<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ars_sale_form_inherit_edit" model="ir.ui.view">
            <field name="name">crm.lead.form.simple.edit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_create_opportunity_simplified"/>
            <field name="arch" type="xml">
                <!--<xpath expr="//form/sheet/group/group[1]/field[@name=''email_from]" position="replace">-->
                <!--<field name="email_from"/>-->
                <!--</xpath>-->
                <field name="partner_id" position="before">
                    <field name="company_type" required="True"/>
                </field>
                <field name='phone' position="before">
                    <!--                    <field name="mobile" string="Mobile"/>-->
                </field>
                <field name="email_from" position="replace">
                    <!--                    <field name="email_from"/>-->
                </field>
                <field name='phone' position="after">
                    <!--                    <field name="product_id" string="Model Interested" domain="[('catalog_type.name', '=','Vehicle')]"/>-->
                </field>
                <field name='planned_revenue' position="replace">
                    <field name="planned_revenue" invisible="1"/>
                </field>
                <label for="planned_revenue" position='attributes'>
                    <attribute name='invisible'>1</attribute>
                </label>
                <field name="name" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="partner_id" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <!--                <field name="stage_id" position="attributes">-->
                <!--                    <attribute name="options">{"no_create": True}</attribute>-->
                <!--                </field>-->

                <field name="priority" position="before">
                    <field name="email_from" required="1"/>
                    <field name="mobile" required="1" string="Mobile"/>
                     <field name="model_id" string="Product Model" domain="[('catalog_type.name', '=','Vehicle')]"
                           options="{'no_create':True,'no_open':True}"
                           required="1"/>
                    <field name="product_id" string="Variant Interested" domain="[('catalog_type.name', '=','Vehicle'),('product_tmpl_id','=',model_id)]"
                           options="{'no_create':True,'no_open':True}"
                           required="1"/>
                    <field name="source_id" string="Source" required="1" options="{'no_create':True,'no_open':True}"/>
                    <field name="city" required="1" string="City"/>
                </field>
            </field>
        </record>


        <record id="sale_view_inherit124" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sale.hide</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
            <field name="arch" type="xml">
                <field name="source_id" position="attributes">
                    <attribute name="options">{'no_create':True,'no_edit':True}</attribute>
                </field>
                <field name="medium_id" position="attributes">
                    <attribute name="options">{'no_create':True,'no_edit':True}</attribute>
                </field>
            </field>
        </record>

        <record id="ars_sale_order_inherit_edit" model="ir.ui.view">
            <field name="name">sale.order.form.simple.edit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name='partner_id' position="after">
                    <field name="mobile" required="1" string="Mobile"
                           attrs="{'readonly':[('state','in',['sale','done'])]}"/>
                    <field name="email" required="1" attrs="{'readonly':[('state','in',['sale','done'])]}"/>
                </field>
                <field name="payment_term_id" position="after">
                    <field name="user_id" required="1" options="{'no_create': True, 'no_open':True}"
                           domain="[('salesperson', '=', True)]" attrs="{'readonly':[('state','in',['sale','done'])]}"/>
                    <field name="bank_account" options="{'no_create': True,'no_edit':True,'no_open':True}"/>
                </field>
                <xpath expr="//notebook/page[1]/field[@name='order_line']/tree/field[@name='tax_id']" position="after">
                    <field name="price_tax" string="Tax Price"/>
                </xpath>
                <xpath expr="//notebook/page[1]/field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
                    <field name="price_total" string="Price Total"/>
                </xpath>
            </field>
        </record>

        <!--<record id="sale_order_form_inherit" model="ir.ui.view">-->
        <!--<field name="name">sale.order.line.form</field>-->
        <!--<field name="model">sale.order.line</field>-->
        <!--<field name="inherit_id" ref="sale.view_order_form"/>-->
        <!--<field name="arch" type="xml">-->
        <!--<xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='price_unit']" position="before">-->
        <!--<field name="vin_no"/>-->
        <!--</xpath>-->
        <!--</field>-->
        <!--</record>-->

        <record id="ars_sale_crm_inherit_edit" model="ir.ui.view">
            <field name="name">crm.lead.form.simple.edit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
            <field name="arch" type="xml">

                <field name="user_id" position="replace"/>
                <field name="priority" position="replace"/>
                <field name="tag_ids" position="replace"/>

                <field name="phone" position="after">
                    <field name="mobile" required="True"></field>
                    <field name="is_test_drive" readonly="True"/>
                    <field name="model_id" force_save="1"/>
                    <field name="booking_date" readonly="True" force_save="1" />
                </field>
                <field name="phone" position="attributes">
                    <attribute name="invisible">True</attribute>
                </field>
                <field name="phone" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="function" position="before">
                    <field name="priority" widget="priority"/>
                    <field name="tag_ids" widget="many2many_tags"
                           options="{'color_field': 'color', 'no_create_edit': True}"/>
                    <field name="user_id" domain="[('share', '=', False),('salesperson', '=', True)]"
                           options="{'no_create': True, 'no_open': True}" required="1"
                           context="{'default_groups_ref': ['base.group_user', 'base.group_partner_manager', 'sales_team.group_sale_salesman_all_leads'], 'team_id': team_id}"/>
                </field>
                <field name="function" position="replace"/>
                <field name="opt_out" position="before">
                    <label for="dob" style="font-weight: bold;"/>
                    <div class="o_row">
                        <field name="dob"/>
                        <field name="age" placeholder="Age" domain="[]"/>
                    </div>
                    <field name="gender"/>
                    <field name="annual_income" options="{'no_create': True}"/>
                    <field name="phone"></field>
                    <field name="function"></field>
                </field>
                <!--<xpath expr="//form/sheet/notebook/page[2]/group/group[2]/field[@name='mobile']" position="after">-->
                <!--<field name="phone"></field>-->
                <!--</xpath>-->

                <xpath expr="//form/sheet/group/group[3]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//form/sheet/group/group[4]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="action" icon="fas fa-car"
                            name="%(ars_test_drive_tree_action)d">
                        <div class="o_stat_info">
                            <field name="no_of_test_drive"/>
                            <span class="o_stat_text">Test Drive</span>
                        </div>
                    </button>
                </xpath>
                <field name="contact_name" position="attributes">
                    <attribute name="required">True</attribute>
                </field>
                <field name="source_id" position="attributes">
                    <attribute name="required">True</attribute>
                    <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                </field>
                <field name="medium_id" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                </field>
                <field name="campaign_id" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                </field>
                <field name="mobile" position="attributes">
                    <attribute name="required">True</attribute>
                </field>
                <field name="email_from" position="attributes">
                    <attribute name="required">True</attribute>
                </field>
                <field name="source_id" position="after">
                    <field name="sales_type" groups="base.group_no_one"/>
                </field>
<!--                <xpath expr="//button[@name='action_set_won']" position="replace">-->
<!--                    <button name="action_set_won" string="Mark Won"-->
<!--                            type="object" class="oe_highlight"-->
<!--                            attrs="{'invisible': True}"/>-->
<!--                </xpath>-->
            </field>
        </record>

        <record id="invoice_form_sale_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <field name='payment_term_id' position="before">
                    <field name="mobile" required="1" attrs="{'readonly':[('state','not in',['draft'])]}"/>
                    <field name="email" required="1" attrs="{'readonly':[('state','not in',['draft'])]}"/>
                    <field name="delivery_type" attrs="{'readonly':[('state','not in',['draft'])]}" groups="base.group_no_one"/>
                    <field name="after_sale_intro" attrs="{'readonly':[('state','not in',['draft'])]}" groups="base.group_no_one"/>
                </field>
                <field name='payment_term_id' position="replace"/>
                <xpath expr="//form/sheet/group/group[2]/field[@name='team_id']" position="after">
                    <field name="payment_term_id"/>
                </xpath>
                <xpath expr="//form/sheet/group/group[2]/field[@name='team_id']" position="replace">
                    <field name="team_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="ars_sale_form_inherit" model="ir.ui.view">
            <field name="name">ars_sale_form_inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <button name="action_confirm" id="action_confirm" position="after">
                    <field name="is_approve" invisible="1"/>
                    <button name="action_confirm" id="to_approve"
                            string="To Approve" class="btn-primary" type="object"
                            attrs="{'invisible': [('is_approve', '=', False)]}"/>
                </button>
                <button name="action_cancel" type="object" position="attributes">
                    <attribute name="states">draft,sent,sale,to_approve</attribute>
                </button>
            </field>
        </record>

    </data>
</odoo>
