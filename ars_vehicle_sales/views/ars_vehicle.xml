                            <notebook>
                                <page string="Service History">
                                    <field name="service_ids">
                                        <tree editable="bottom">
                                            <field name="order" string="RO No"/>
                                            <field name="servicetype" string="Service Type"/>
                                            <field name="date" string="Date"/>
                                            <field name="mileage" string="Mileage"/>
                                            <field name="next_service_due" string="Next Service Due"/>
                                            <field name="set_reminder" string="Set Reminder"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Ownership History">
                                    <field name="customer_ids" readonly="True">
                                        <tree editable="bottom">
                                            <field name="custmer_name" string="Customer Name"/>
                                            <field name="date_of_ownership" string="Date of Ownership"/>
                                            <field name="address" string="Address"/>
                                            <field name="mobile" string="Mobile"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Insurance History">
                                    <field name="insurance_ids">
                                        <tree editable="bottom">
                                            <field name="insurance_doc_no" string="Insurance Doc No"/>
                                            <field name="vender_name" string="Vendor Name"/>
                                            <field name="insurance_start" string="Insurance Start Date"/>
                                            <field name="insurance_end" string="Insurance End Date"/>
                                            <field name="set_reminder" string="Set Reminder"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Emission History">
                                    <field name="emission_ids">
                                        <tree editable="bottom">
                                            <field name="emission_doc_no" string="Emission Doc No"/>
                                            <field name="agency_name" string="Agency Name"/>
                                            <field name="emission_start" string="Emission Start Date"/>
                                            <field name="emision_end" string="Emission End Date"/>
                                            <field name="set_reminder" string="Set Reminder"/>
                                        </tree>
                                    </field>
                                </page>

                            </notebook>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="message_ids" widget="mail_thread" options='{"thread_level": 1}'/>
                        </div>
                    </form>
                </form>
            </field>
        </record>


        <record id='ars_fleet_vehicle_view_kanban' model='ir.ui.view'>
            <field name="name">ars.fleet.vehicle.kanban</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
            <field name="arch" type="xml">
                <strong class="o_kanban_record_title" position="replace">
                    <t t-if="record.license_plate.raw_value != '/'">
                        <strong class="o_kanban_record_title">
                            <field name="license_plate"/>
                            :
                            <field name="model_id"/>
                            :
                            <field name="mvariant_id"/>
                        </strong>
                    </t>
                    <t t-if="record.license_plate.raw_value == '/'">
                        <strong class="o_kanban_record_title">
                            <field name="vin_sn"/>
                            :
                            <field name="model_id"/>
                            :
                            <field name="mvariant_id"/>
                        </strong>
                    </t>
                </strong>
            </field>
        </record>
        <menuitem name="Vehicles" id="fleet.menu_root" sequence="115" groups="fleet.fleet_group_user"
                  web_icon="fleet,static/description/icon.png"/>


        <!--Update QTY Product Add domain filter in lot_id-->
        <record id="view_change_product_quantity_inherit" model="ir.ui.view">
            <field name="name">Change Product Quantity</field>
            <field name="model">stock.change.product.qty</field>
            <field name="inherit_id" ref="stock.view_change_product_quantity"/>
            <field name="arch" type="xml">
                <xpath expr="//form/group/field[@name='lot_id']" position="replace">
<!--                    ,('check_new_lotno','!=',True)-->
                    <field name="lot_id"  domain="[('product_id', '=', product_id)]"
                           context="{'search_default_product_id':product_id,'default_product_id':product_id}"
                           groups="stock.group_production_lot"/>
                </xpath>
            </field>
        </record>
        <record id="fleet_vehicle_view_tree_inherit" model="ir.ui.view">
            <field name="name">fleet.vehicle.tree</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
            <field name="arch" type="xml">
                <field name="driver_id" position="replace">
                    <field name="driver_id" string="Customer"/>
                    <field name="contact_name" string="Contact Person"/>
                </field>
                <field name="vin_sn" position="attributes">
                    <attribute name="string">VIN Number</attribute>
                </field>

            </field>
        </record>
    </data>
</odoo>
