        <record id='ars_vehicle_view_form_inherit' model='ir.ui.view'>
            <field name="name">ars_vehicle_view_form_inherit</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <form position="replace">
                    <form string="Vehicle">
                        <header>
                            <field name="state_id" widget="statusbar" clickable="True"/>
                        </header>
                        <sheet>
                            <div class="oe_button_box" name="button_box">
                                <button name="return_action_to_open"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-book"
                                        context="{'xml_id':'fleet_vehicle_log_contract_action', 'search_default_open': 1}"
                                        help="show the contract for this vehicle">
                                    <field name="contract_count" widget="statinfo" string="Contracts"/>
                                </button>
                                <button name="act_show_log_cost"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-usd"
                                        help="show all the costs for this vehicle"
                                        groups="fleet.fleet_group_manager">
                                    <field name="cost_count" widget="statinfo" string="Costs"/>
                                </button>
                                <!--<button name="return_action_to_open"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-wrench"
                                    context="{'xml_id':'fleet_vehicle_log_services_action'}"
                                    help="show the services logs for this vehicle" >
                                    <field name="service_count" widget="statinfo" string="Services"/>
                                </button>-->
                                <button name="return_action_to_open"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-flask"
                                        context="{'xml_id':'fleet_vehicle_log_fuel_action'}"
                                        help="show the fuel logs for this vehicle">
                                    <field name="fuel_logs_count" widget="statinfo" string="Fuel"/>
                                </button>
                                <button name="return_action_to_open"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-tachometer"
                                        context="{'xml_id':'fleet_vehicle_odometer_action'}"
                                        help="show the odometer logs for this vehicle">
                                    <field name="odometer_count" widget="statinfo" string="Odometer"/>
                                </button>
                                <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                    <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                                </button>
                                <button
                                        icon="fa-align-justify"
                                        name="get_vehcile_features"
                                        string="Vehicle Features" type="object"
                                        target="new"/>
                            </div>
                            <field name="image_medium" widget='image' class="oe_avatar"/>
                            <div class="oe_title">
                                <label for="model_id" class="oe_edit_only"/>
                                <h1>
                                    <field name="model_id" domain="[('catalog_type','=','Vehicle')]"
                                           placeholder="e.g. Model S"/>
                                </h1>
                                <label for="mvariant_id" class="oe_edit_only"/>
                                <h2>
                                    <field name="mvariant_id" class="oe_inline"
                                           domain="[('product_tmpl_id','=',model_id)]" required="1"/>
                                </h2>
                                <label for="license_plate" class="oe_edit_only"/>
                                <h2>
                                    <field name="license_plate" class="oe_inline" placeholder="e.g. PAE 326"/>
                                </h2>
                                <label for="tag_ids" class="oe_edit_only"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                            </div>

                    <group>
                        <group>
                            <group colspan="4" string="Customer Details">
                                <field name="driver_id" string="Customer"/>
                                <field name="contact_name" string="Contact Person"/>
                            </group>
                            <group colspan="4" string="Vehicle Specification">
                                <field name="categ_id" readonly="1"/>
                                <field name="fuel_type" />
                                <field name="engine_code"/>
                                <field name="engine_number" string="Motor Number"/>
                                <field name="key_serial_number"/>
                                <label for="co2"/>
                                <div class="o_row" name="co2">
                                    <field name="co2"/><span>g/km</span>
                                </div>
                                <field name="horsepower" />
                                <field name="horsepower_tax" />
                                <label for="power"/>
                                <div class="o_row">
                                    <field name="power"/><span>kW</span>
                                </div>
                            </group>
                        </group>
                        
                        <group>
                           <group colspan="4" string="Vehicle Information">
                                <field name="vehicle_status" attrs="{'readonly':[('vehicle_status','=','new')]}"/>
                                <field name="initial_reg_no"/>
                                <field name="vin_sn" string="VIN"/>
                                <label for="model_year"/>
                                <div class="o_row">
                                    <field name="model_month" />
                                    <field name="model_year"/>
                                </div>
                                <label for="prodcution_year"/>
                                <div class="o_row">
                                    <field name="prodcution_month" />
                                    <field name="prodcution_year"/>
                                </div>
                                <label for="odometer"/>
                                <div class="o_row">
                                    <field name="odometer"/>
                                    <field name="odometer_unit"/>
                                </div>
                               <field name="location"/>
                           </group>
                            <group colspan="4" string="Warranty Details">
                                <field name="warranty_validation"/>
                                <field name="extented_warranty_no"/>
                                <field name="emission_test_category" string="Emmision category"/>
                                <field name="extented_warranty_validation" string="Extented Warranty validation"/>
                                <field name="transmission" />
                            </group>
                        </group>
                            </group>

