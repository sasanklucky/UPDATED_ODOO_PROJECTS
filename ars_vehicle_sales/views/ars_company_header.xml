<odoo>
    <template id="external_layout_inherited_web" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@class='header']" position="replace">
            <div class="header">
                <div class="row">
                    <div class="col-xs-4">
                        <img t-if="company.make_id" t-att-src="'data:image/png;base64,%s' % to_text(company.make_id.image_medium)" style="max-height: 65px;" />
                    </div>
                    <div class="col-xs-8 text-right">
                        <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % to_text(company.logo)" style="max-height: 65px;" />
                    </div>
                </div>
                <div t-if="company.logo or company.report_header" class="row zero_min_height">
                    <div class="col-xs-12">
                        <div style="margin-top:22px;" t-field="company.report_header" name="moto" />
                        <!--  <div style="border-bottom: 1px solid black;"/>  -->
                    </div>
                </div>
                <div class="row">
                    <div t-if="company.name" class="col-xs-12 text-center">
                        <span style="font-weight: bold; font-size:18px;" t-field="company.name" />
                    </div>
                    <div class="col-xs-12 text-center">
                        <t t-if="company.partner_id.pan_no">
                            <b>PAN: </b>
                            <span t-field="company.partner_id.pan_no" />
                        </t>
                        <t t-if="company.partner_id.vat">
                            <b>GSTIN: </b>
                            <span t-field="company.vat" />
                        </t>
                    </div>
                    <div class="col-xs-12 text-center">
                        <b>Add: </b>
                        <t t-if="company.street">
                            <span t-field="company.street" />
                            ,
                        </t>
                        <t t-if="company.street2">
                            <span t-field="company.street2" />
                            ,
                        </t>
                        <t t-if="company.city">
                            <span t-field="company.city" />
                            ,
                        </t>
                        <t t-if="company.state_id">
                            <span t-field="company.state_id.name" />
                            ,
                        </t>
                        <t t-if="company.country_id">
                            <span t-field="company.country_id.name" />
                            ,
                        </t>
                        <t t-if="company.zip">
                            <span t-field="company.zip" />
                        </t>
                    </div>
                    <div class="col-xs-12 text-center">
                        <t t-if="company.email">
                            <b>Email ID:</b>
                            <span t-field="company.email" />
                        </t>
                        <t t-if="company.website">
                            <b>URL: </b>
                            <span t-field="company.website" />
                        </t>
                        <t t-if="company.phone">
                            <b>Phone: </b>
                            <span t-field="company.phone" />
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="div[@class='article o_report_layout_standard']" position="replace">
            <div class="article o_report_layout_standard mt-3">
                <t t-raw="0" />
            </div>
        </xpath>
        <xpath expr="//div[@class='footer']" position="replace">
            <div class="footer">
                <div t-if="company.name" class="col-xs-12 text-left">
                    <b>
                        <i>Registered Name: </i>
                    </b>
                    <span t-field="company.name" />
                </div>
                <div class="col-xs-12 text-left">
                    <b>
                        <i>Registered Office Add: </i>
                    </b>
                    <t t-if="company.street">
                        <span t-field="company.street" />
                        ,
                    </t>
                    <t t-if="company.street2">
                        <span t-field="company.street2" />
                        ,
                    </t>
                    <t t-if="company.city">
                        <span t-field="company.city" />
                        ,
                    </t>
                    <t t-if="company.state_id">
                        <span t-field="company.state_id.name" />
                        ,
                    </t>
                    <t t-if="company.country_id">
                        <span t-field="company.country_id.name" />
                        ,
                    </t>
                    <t t-if="company.zip">
                        <span t-field="company.zip" />
                    </t>
                </div>
                <div name="financial_infos" class="text-left">
                    <span t-field="company.report_footer" />
                </div>
                <div class="text-center">
                    <div class="text-muted">
                        Page:
                        <span class="page" />
                        /
                        <span class="topage" />
                    </div>
                </div>
            </div>
        </xpath>
    </template>
