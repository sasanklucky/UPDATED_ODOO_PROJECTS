<odoo>
  <data>
    <record id="invoice_form_sales_inherit" model="ir.ui.view">
            <field name="name"> .form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_open': True,'no_create':True,'no_edit':True}</attribute>
                </xpath>
                <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                    <field name="vin_no"/>
                </xpath>
                <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                    <field name="product_varient_ids" widget="many2many_tags" invisible="1" required='0' options="{'no_create': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="before">
                    <field name="product_template_id"  options="{'no_create': True, 'no_open': True}" required='1'/>
                </xpath>
                <!-- <xpath expr="//field[@name='date_invoice']" position="after">
                  <field name="gate_pass_date" />
                </xpath> -->
                <!-- <field name='date_due' position="before">
                  <field name="gate_pass_date"/>
              </field> -->
                <xpath expr="//form//header" position="inside">
                      <button class="btn-primary" type="object" name="action_print_gate_pass" string="Print Gate Pass"/>
                      <!-- <button name="%(gatepass_report)d" class="btn-primary" string="Print Gate Pass" type="action" /> -->
                      <button name="send_whatsapp" class="btn-primary" string="Send In Whatsapp" type="object" />
                </xpath>
            </field>
    </record>
    

    <!-- Sellable Products action form view change -->
    <record model="ir.actions.act_window" id="account.product_product_action_sellable">
        <field name="view_ids"
               eval="[(5, 0, 0),
                  (0, 0, {'view_mode': 'tree', 'view_id': ref('account.product_product_view_tree')}),
                  (0, 0, {'view_mode': 'form', 'view_id': ref('ars_vehicle_sales.product_template_form_view_inherit1')})]"/>
    </record>


  </data>
</odoo>
