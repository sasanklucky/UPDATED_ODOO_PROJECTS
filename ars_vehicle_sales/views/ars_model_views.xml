        <record id="action_models" model="ir.actions.act_window">
            <field name="name">Models</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_tracking':'serial'}</field>
            <field name="view_type">form</field>
            <!--<field name="view_id" ref="product_template_form_view_inherit1"/>-->
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('product.product_template_kanban_view')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('product.product_template_tree_view')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('product_template_form_view_inherit1')})]"/>
            <field name="domain">[('catalog_type','=', 'Vehicle')]</field>
            <field name='limit'>20</field>

        </record>

        <menuitem name="Models" id="sale.menu_product_template_action" action="ars_vehicle_sales.action_models"
