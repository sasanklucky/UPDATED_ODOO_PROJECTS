<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="detailed_service_history_template_inherit" inherit_id="ars_reports.detailed_service_history_template">
        <xpath expr="//div/div" position="replace"/>
        <xpath expr="//t[@t-foreach='doc.service_ids']" position="replace">
            <t t-set="data" t-value="doc._get_service_history_from_dealers()"/>
            <t t-set="all_service_history" t-value="data['all_service_details']"/>
            <t t-set="summary_service_history" t-value="data['service_details']"/>
            <div style="font-weight:bold;width:100%;padding: 0px 2px;text-align: center;">
                    <span style="font-size:16px;color:black;font-weight:bold;">
                        <u>SUMMARY OF SERVICE HISTORY FOR THIS VEHICLE</u>
                    </span>
                </div>
                <span style="font-weight:bold">Total Number of Services Done:</span>
                <t t-esc="len(doc.service_ids)"/>
            <br/>
            <table class="table-bordered" name="service_line_table"
                   style="border:1px solid black;margin-bottom: 2px;width: 100%;">
                <thead>
                    <tr style="background-color:#e0e0e0">
                        <th class="text-center" style="border:1px solid black;">SR Num</th>
                        <th class="text-center" style="border:1px solid black;">Open Date</th>
                        <th class="text-center" style="border:1px solid black;">Closed Date</th>
                        <th class="text-center" style="border:1px solid black;">SR Type</th>
                        <th class="text-center" style="border:1px solid black;">Odometer Reading</th>
                        <th class="text-center" style="border:1px solid black;">Servicing Dealer</th>
                    </tr>
                </thead>
                <tbody class="service_line_body">
                    <tr t-foreach="summary_service_history" t-as="l">
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['name']"/>
                            <!--                            <span t-field="l[]"/>-->
                        </td>
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['date_order']"/>
                            <!--                            <span t-field="l.order.date_order" tz="IST"/>-->
                        </td>
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['sr_close_date']"/>
                            <!--                            <span t-esc="l.order.invoice_ids.mapped('create_date')[-1]"/>-->
                        </td>
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['servicetype']"/>
                            <!--                            <span t-field="l.servicetype"/>-->
                        </td>
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['mileage']"/>
                            <!--                            <span t-field="l.mileage"/>-->
                        </td>
                        <td class="text-center" style="background-color:#FFF;border:1px solid black">
                            <span t-esc="l['dealer_name']"/>
                            <!--                            <span t-field="l.order.company_id.name"/>-->
                        </td>
                    </tr>
                </tbody>
            </table>
            <br/>
            <div style="font-weight:bold;width:100%;padding: 0px 2px;text-align: center;">
                <span style="font-size:20px;color:black;font-weight:bold;">
                    <u>Detailed Service History</u>
                </span>
            </div>
            <t t-foreach="all_service_history" t-as="service_history">

                <div>
                    <div>
                        <br></br>
                        <!--                        <t t-set="service_history" t-value="o"/>-->
                        <table class="table table-sm"
                               style="border-collapse: collapse;margin-top:2px; margin-bottom:1px;background-color:E1D0D9">
                            <tr>
                                <td style="padding: 0px 2px;font-weight:bold;">SR NUM</td>
                                <td style="padding: 0px 2px">
                                    <span t-esc="service_history['name']"/>
                                </td>
                                <td style="padding: 0px 2px;font-weight:bold;">SR Open Date
                                </td>
                                <td style="padding: 0px 2px">
                                    <span t-esc="service_history['date_order']" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style=";padding: 0px 2px;font-weight:bold;">SR Type</td>
                                <td style="padding: 0px 2px">
                                    <!--                                    <span t-field="o.servicetype"/>-->
                                    <span t-esc="service_history['servicetype']"/>
                                </td>
                                <td style="padding: 0px 2px;font-weight:bold;">SR Close Date
                                </td>
                                <td style="padding: 0px 2px">
                                    <span t-esc="service_history['date_order']"
                                          t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 0px 2px;font-weight:bold;">SR Status</td>
                                <td style="padding: 0px 2px">
                                    <!--                                    <span t-field="o.servicetype"/>-->
                                    <span t-esc="service_history['servicetype']"/>

                                </td>
                                <td style="padding: 0px 2px;font-weight:bold;">Odometer
                                    reading
                                </td>
                                <td style="padding: 0px 2px">
                                    <!--                                    <span t-field="o.mileage"/>-->
                                    <span t-esc="service_history['mileage']"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <br></br>
                    <table class="table table-sm"
                           style="border:1px solid black;border-collapse: collapse;margin-top:2px; margin-bottom:1px;">
                        <tr>
                            <td style="border:0px solid black;padding: 0px 2px;font-weight:bold;">RO NUM</td>
                            <td style="border:0px solid black;padding: 0px 2px">
                                <span t-esc="service_history['name']"/>
                            </td>
                            <td style="border:1px solid black;padding: 0px 2px;font-weight:bold;">RO Open Date
                            </td>
                            <td style="border:1px solid black;padding: 0px 2px">
                                <span t-esc="service_history['date_order']" t-options='{"widget": "date"}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:0px solid black;padding: 0px 2px;font-weight:bold;">RO Type</td>
                            <td style="border:0px solid black;padding: 0px 2px">
                                <!--                                <span t-field="o.servicetype"/>-->
                                <span t-esc="service_history['servicetype']"/>

                            </td>
                            <td style="border:1px solid black;padding: 0px 2px;font-weight:bold;">RO Close Date
                            </td>
                            <td style="border:1px solid black;padding: 0px 2px">
                                <span t-esc="service_history['sr_close_date']"
                                      t-options='{"widget": "date"}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:0px solid black;padding: 0px 2px;font-weight:bold;">RO Sub Type</td>
                            <td style="border:0px solid black;padding: 0px 2px">
                                <!--                                <span t-field="o.servicetype"/>-->
                                <span t-esc="service_history['servicetype']"/>

                            </td>
                            <td style="border:1px solid black;padding: 0px 2px;font-weight:bold;">RO Status
                            </td>
                            <td style="border:1px solid black;padding: 0px 2px">
                                <!--                                <span t-field="o.mileage"/>-->
                                <span t-esc="service_history['mileage']"/>


                            </td>
                        </tr>
                    </table>
                    <br></br>
                    <table class="table-bordered" style="width: 100%;">
                        <thead>
                            <tr style="background-color:#e0e0e0">
                                <th class="text-center" style="border:1px solid black;">Compalints</th>
                                <th class="text-center" style="border:1px solid black;">Instruction</th>
                            </tr>
                        </thead>
                        <tr t-foreach="service_history['customer_voice']" t-as="l">
                            <td style="background-color:#FFF;border:1px solid black">
                                <span t-esc="l['name']"/>
                            </td>
                            <td style="background-color:#FFF;border:1px solid black">
                                <span t-esc="l['instructions']"/>
                            </td>
                        </tr>
                    </table>
                    <br></br>
                    <table class="table-bordered" name="service_line_table"
                           style="border:1px solid black;margin-bottom: 2px;width: 100%;">
                        <thead>
                            <tr style="background-color:#e0e0e0">
                                <th class="text-center" style="border:1px solid black;">P/L</th>
                                <th class="text-center" style="border:1px solid black;">Labor Code/Part#</th>
                                <th class="text-center" style="border:1px solid black;">Description</th>
                                <th class="text-center" style="border:1px solid black;">Issue Type</th>
                                <th class="text-center" style="border:1px solid black;">QTY</th>
                            </tr>
                        </thead>
                        <tbody class="service_tbody">
                            <tr t-foreach="service_history['order_line']" t-as="sol">
                                <td class="text-center" style="background-color:#FFF;">
                                    <span t-esc="sol['name']"/>
                                </td>
                                <td class="text-center" style="background-color:#FFF;">

                                    <span t-esc="sol['default_code']"/>
                                </td>
                                <td class="text-center" style="background-color:#FFF;">
                                    <span t-esc="sol['description']"/>
                                </td>
                                <td class="text-center" style="background-color:#FFF;">
                                    <span t-esc="sol['category_type']"/>
                                </td>
                                <td class="text-center" style="background-color:#FFF;">
                                    <span t-esc="sol['product_uom_qty']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <br/>
            </t>
        </xpath>
    </template>

<!--    <template id="vehicle_service_history_template_inherit" inherit_id="ars_reports.vehicle_service_history_template">-->
<!--        <xpath expr="//table[@name='service_line_table']" position="replace"/>-->
<!--    </template>-->

</odoo>
