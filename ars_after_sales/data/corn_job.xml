<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
<!--        Service Due Reminder Schedule Action-->
        <record id="ir_cron_service_due_reminder" model="ir.cron">
            <field name="name">Service Due Reminder</field>
            <field name="model_id" ref="model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.creation_of_lead_for_service()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
        </record>
    </data>
</odoo>