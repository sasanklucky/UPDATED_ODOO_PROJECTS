<odoo>
    <data>

        <template id="report_warranty_customer_invoice_with_payments">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="cus_warranty" t-value="True"/>
                    <t t-call="account.report_invoice_document_with_payments" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <report
                id="ars_after_sales.account_warranty_customer_invoices"
                model="account.invoice"
                string="Warranty Cus Invoices"
                report_type="qweb-pdf"
                name="ars_after_sales.report_warranty_customer_invoice_with_payments"
                file="ars_after_sales.report_warranty_customer_invoice_with_payments"
                attachment="(object.state in ('open','paid')) and ('INV'+(object.number or '').replace('/','')+'.pdf')"
                print_report_name="(object._get_printed_report_name())"
                menu="False"
        />

    </data>
</odoo>