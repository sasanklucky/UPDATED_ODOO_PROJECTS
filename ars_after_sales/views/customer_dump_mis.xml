<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- model.name tree view -->
        <record id="customer_dump_mis_tree" model="ir.ui.view">
            <field name="name">customer_enquiry_dump_mis_report</field>
            <field name="model">customer_dump_mis_report</field>
            <field name="arch" type="xml">
                <tree string="Customer Enquiry Dump Mis Report" decoration-bf="enquiry_category == 'HOT'" decoration-danger="enquiry_category == 'COLD'" decoration-success="enquiry_category == 'HOT'" decoration-warning="enquiry_category == 'WARM'" create="false" import="false" delete="false">
                    <field name="dealer_zone" string="Dealer Zone"/>
                    <field name="dealer_code" string="Dealer Code"/>
                    <field name="company_id"/>
                    <field name="record_id" invisible="1"/>
                    <field name="enquiry_date"/>
                    <field name="lead_creation_date"/>
                    <field name="opportunity_conversion_date"/>
                    <field name="purchase_date"/>
                    <field name="no_of_days"/>
                    <field name="enquiry_category"/>
                    <field name="user_id"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="title"/>
                    <field name="contact_name"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="email"/>
                    <field name="city" string="City"/>
                    <field name="address" invisible="1"/>
                    <field name="address1" invisible="1"/>
                    <field name="address2" string="Address"/>
                    <field name="make" string="Vehicle Make"/>
                    <field name="master_group" string="Model Group"/>
                    <field name="model" string="Vehicle Model"/>
                    <field name="product_id"/>
                    <field name="color" string="Color"/>
                    <field name="source_id"/>
                    <field name="medium" string="First Enquiry Mode"/>
                    <field name="test_drive" string="Test Drive" />
                    <field name="test_drive_date"/>
                    <field name="test_drive_remark"/>
                    <field name="invoice" string="Proforma Invoice"/>
                    <field name="stage_id" string="Enquiry Status"/>
                    <field name="lost_reason" string="Lost Sales Reason"/>
                    <field name="existing_customer" string="Existing BYD Customer"/>
                    <field name="referred" string="BYD Referral"/>
                    <field name="note_1"/>
                    <field name="remarks_1"/>
                    <field name="activity_cr_date_1"/>
                    <field name="note_2"/>
                    <field name="remarks_2"/>
                    <field name="activity_cr_date_2"/>
                    <field name="note_3"/>
                    <field name="remarks_3"/>
                    <field name="activity_cr_date_3"/>
                </tree>
            </field>
        </record>

        <record id="customer_dump_mis_action" model="ir.actions.act_window">
            <field name="name">Customer Enquiry Dump Mis Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">customer_dump_mis_report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
        </record>
        
        

    </data>
</odoo>
