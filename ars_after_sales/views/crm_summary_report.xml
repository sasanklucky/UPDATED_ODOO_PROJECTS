<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- model.name tree view -->
        <record id="crm_summary_tree" model="ir.ui.view">
            <field name="name">crm.summary.report</field>
            <field name="model">crm.summary.report</field>
            <field name="arch" type="xml">
                <tree string="CRM Summary Report" create="false" import="false" delete="false">
                    <field name="sales_consultant" string="Sales Consultant"/>
                    <field name="mtd_enquiries" string="MTD Enquiries"/>
                    <field name="total_open_enquiries"  string="Total Open Enquiries"/>
                    <field name="lost_enquiries_for_month"  string="Lost Enquiries for the Month"/>
                    <field name="hot_prospect"  string="Hot Prospect"/>
                    <field name="td"  string="TD"/>
                    <field name="td_ratio"  string="TD Ratio"/>
                    <field name="fresh_bookings"  string="Fresh Bookings"/>
                    <field name="td_to_booking_ratio"  string="TD to Booking Ratio"/>
                    <field name="open_bookings"  string="Open Bookings"/>
                    <field name="deliveries"  string="Deliveries"/>
                </tree>
            </field>
        </record>

        <record id="crm_summary_search" model="ir.ui.view">
            <field name="model">crm.summary.report</field>
            <field name="arch" type="xml">
                <search string="Views">
                    <field name="sales_consultant" string="Sales Consultant"/>
                    <field name="mtd_enquiries" string="MTD Enquiries"/>
                    <field name="total_open_enquiries"  string="Total Open Enquiries"/>
                    <field name="lost_enquiries_for_month"  string="Lost Enquiries for the Month"/>
                    <field name="hot_prospect"  string="Hot Prospect"/>
                    <field name="td"  string="TD"/>
                    <field name="td_ratio"  string="TD Ratio"/>
                    <field name="fresh_bookings"  string="Fresh Bookings"/>
                    <field name="td_to_booking_ratio"  string="TD to Booking Ratio"/>
                    <field name="open_bookings"  string="Open Bookings"/>
                    <field name="deliveries"  string="Deliveries"/>
                    <filter string="Source" name="source_filter" domain="[('payment_type','=','outbound')]"/>
                </search>
            </field>
        </record>


        <record id="crm_summary_report_action" model="ir.actions.act_window">
            <field name="name">CRM Summary Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.summary.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
<!--            <field name="search_view_id" ref="crm_summary_search"/>-->
        </record>




        <record id="crm_summary_source_tree" model="ir.ui.view">
            <field name="name">crm.summary.source.report</field>
            <field name="model">crm.summary.source.report</field>
            <field name="arch" type="xml">
                <tree string="CRM Summary Source Report" create="false" import="false" delete="false">
                    <field name="source" string="Source"/>
                    <field name="mtd_enquiries" string="MTD Enquiries"/>
                    <field name="total_open_enquiries"  string="Total Open Enquiries"/>
                    <field name="lost_enquiries_for_month"  string="Lost Enquiries for the Month"/>
                    <field name="hot_prospect"  string="Hot Prospect"/>
                    <field name="td"  string="TD"/>
                    <field name="td_ratio"  string="TD Ratio"/>
                    <field name="fresh_bookings"  string="Fresh Bookings"/>
                    <field name="td_to_booking_ratio"  string="TD to Booking Ratio"/>
                    <field name="open_bookings"  string="Open Bookings"/>
                    <field name="deliveries"  string="Deliveries"/>
                </tree>
            </field>
        </record>

