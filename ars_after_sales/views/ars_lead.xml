<odoo>
    <data>
        <record id="crm_case_form_view_leads_inherit1" model="ir.ui.view">
            <field name="name">crm.lead.form.lead.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_form_view_leads"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//h1/field[@name='name']" position="attributes">
                    <attribute name="required">0</attribute>
                </xpath> -->
                <xpath expr="//group/group[1]/label[@for='street']" position="before">
                    <label for="contact_name" string="Contact Name *"/>
                    <div class="o_row">
                        <field name="contact_name" required="True"/>
                        <field name="title" placeholder="Title" domain="[]"
                               options="{'no_create': False, 'no_open': False}"/>
                    </div>
                    <field name="enquiry_date" readonly="1"/>
                    <field name="mobile" string="Mobile *"/>
                    <field name="email_from" widget="email" string="Email *"/>
                    <field name="phone" widget="phone"/>
                    <field name="function"/>
                    <field name="vehicle_line_limit_reached" invisible="1"/>
                    <!--                    <field name="lead_token" readonly="1"/>-->
                    <field name="crm_lead_stage"/>
                    <field name="model_id" force_save="1" readonly="1" string="Model *"/>
                    <field name="booking_date" force_save="1" readonly="1"/>
                </xpath>

                <xpath expr="//group/group[1]/label[@for='street']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[1]/div[@class='o_address_format']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[1]/field[@name='website']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]" position="inside">
                    <label for="street" string="Address"/>
                    <div class="o_address_format">
                        <field name="street" placeholder="Street..." class="o_address_street"/>
                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                        <field name="city" placeholder="City *" class="o_address_city"/>
                        <field name="state_id" class="o_address_state" placeholder="State"
                               options="{&quot;no_open&quot;: True,'no_create':True}"/>
                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                        <field name="country_id" placeholder="Country" class="o_address_country"
                               options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                    </div>
                    <field name="website" widget="url" placeholder="e.g. www.odoo.com"/>
                </xpath>
                <field name="partner_id" position="before">
                    <field name="company_type" required="True" string="Customer Type *"/>
                </field>
                <xpath expr="//group/group[2]/label[@for='contact_name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]/div[@class='o_row']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]/field[@name='function']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]/field[@name='phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]/field[@name='email_from']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/group[2]/field[@name='mobile']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- <field name="contact_name" position="attributes">
                    <attribute name="required">True</attribute>
                </field> -->
                <field name="partner_name" position="attributes">
                    <attribute name="attrs">{'invisible': [('company_type', '=', 'individual')]}</attribute>
                </field>
                <xpath expr="//div[@class='oe_title']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- <field name="function" position="replace"/>
                <field name="email_from" widget="email" position="replace"/>
                <field name="phone" widget="phone" position="replace"/> -->
                <!-- <field name='mobile' position="after">
                    <field name="email_from" widget="email"/>
                    <field name="phone" widget="phone"/>
                    <field name="function" invisible="1"/>
                    <field name="crm_lead_stage"/>

                </field> -->
                <xpath expr="//form/sheet/notebook/page[1]" position="before">
                    <page string="Model Intrested">
                        <field name="vehicle_line" force_save="1" attrs="{'readonly': [('vehicle_line_limit_reached', '=', True)]}">
<!--                        <field name="vehicle_line" attrs="{'readonly': [('vehicle_line_limit_reached', '=', True)]}">-->
                            <tree name="CrmLeadLine" string="Crm Lead Lines" editable="bottom" >
                                <field name="product_catalog_id" domain="[('name', '=', 'Vehicle')]"
                                       options="{'no_create':True, 'no_open':True}"/>
                                <field name="product_template_id" options="{'no_create':True, 'no_open':True}"/>
                                <field name="product_id" string="Variant"
                                       domain="[('catalog_type.name', '=', 'Vehicle'),('sale_ok', '=', True)]"
                                       options="{'no_create':True, 'no_open':True}"
                                       context="{'form_view_ref':'product.product_normal_form_view'}"/>
                                 <field name="crm_ordered_qty" />
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//notebook/page[@name='extra']/group/group[2]/field[@name='source_id']" position="replace">
                </xpath>
                <field name="campaign_id" position="replace"/>
                <field name="medium_id" position="replace"/>
                <field name="referred" position="replace"/>
                <xpath expr="//form/sheet/group/group[4]/field[@name='priority']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/group/group[4]/field[@name='tag_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/group/group[4]/field[@name='tag_ids']" position="after">
                    <field name="source_id" options="{'no_create': True, 'no_open': True}" string="Source *" attrs="{'required': True}"/>
                    <field name="campaign_id" options="{'no_create': False, 'no_open': False}"/>
                    <field name="medium_id" options="{'no_create': True, 'no_open': True}" attrs="{'required': True}" string="Medium *"/>
                    <field name="referred"/>
                </xpath>

                <xpath expr="//form/sheet/group/group[3]/field[@name='user_id']" position="replace">
                    <field name="user_id" domain="[('share', '=', False),('salesperson', '=', True)]"
                           options="{'no_create': True}"
                           required="1" string="Salesperson *"
                           context="{'default_groups_ref': ['base.group_user', 'base.group_partner_manager', 'sales_team.group_sale_salesman_all_leads'], 'team_id': team_id}"/>
                </xpath>
                <field name="user_id" position="after">
                    <field name="priority"/>
                    <field name="tag_ids"/>
                </field>

                <xpath expr="//form/sheet/group/group[3]/field[@name='team_id']" position="replace">
                    <field name="team_id" readonly="1" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- CRM Sales Lead tree view inherit -->
        <record id="crm_case_tree_view_leads_inherit1" model="ir.ui.view">
            <field name="name">crm.lead.tree.lead.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
            <field name="arch" type="xml">
                <field name="create_date" position="replace">
                    <field name="create_date" widget="date" groups="base.group_no_one"/>
                    <field name="enquiry_date" widget="date"/>
                    <field name="activity_date_deadline" widget="date"/>
                    <field name="model_id" force_save="1"/>
                    <field name="date_closed" string="Close Date"/>
                </field>
                <field name="contact_name" position="before">
                    <field name="company_type"/>
                </field>
                <field name='name' position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="phone" position="replace">
                    <field name="mobile" string="Mobile 1 *"/>
                    <field name="source_id"/>
                </field>
                <field name="team_id" position="replace"/>
                <xpath expr="/tree/field[@name='country_id']" position="replace">
                    <field name="country_id" invisible="1"/>
                </xpath>
                <xpath expr="/tree/field[@name='source_id']" position="before">
                    <field name="user_id"/>
                </xpath>

                <field name="medium_id" position="replace">
                    <field name="medium_id" string="Medium *"/>
                </field>

            </field>
        </record>

        <!-- CRM Sales Opportunity tree view inherit -->
        <record id="crm_case_tree_view_opportunity_inherit1" model="ir.ui.view">
            <field name="name">crm.lead.tree.opportunity.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
            <field name="arch" type="xml">
                <field name="country_id" position="replace"/>
                <field name="team_id" position="replace">
                    <field name="mobile"/>
                    <field name="source_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="model_id"/>
                    <field name="date_closed" string="Close Date"/>
                </field>
                <field name="stage_id" position="after">
                    <field name="booking_date"/>
                </field>
            </field>
        </record>

