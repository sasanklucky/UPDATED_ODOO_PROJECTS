<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="warranty_assets_frontend" inherit_id="website.assets_frontend" name="Shop">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/ars_after_sales/static/src/js/ars_script.js"></script>
        </xpath>
    </template>

    <record id="action_stock_quantity_history1" model="ir.actions.act_window">
        <field name="name">Vehicle Inventory Report</field>
        <field name="res_model">stock.quantity.history</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock.view_stock_quantity_history"/>
        <field name="target">new</field>
        <field name="context">{'default_compute_at_date': 0, 'vehicle_inventory': True}</field>
    </record>

    <record id="action_stock_quantity_history2" model="ir.actions.act_window">
        <field name="name">Parts Inventory Report</field>
        <field name="res_model">stock.quantity.history</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock.view_stock_quantity_history"/>
        <field name="target">new</field>
        <field name="context">{'default_compute_at_date': 0, 'parts_inventory': True}</field>
    </record>

    <record model="ir.actions.act_window" id="quantsact1"> <!-- Menu + python -->
        <field name="name">Vehicle Inventory</field>
        <field name="res_model">stock.quant</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('category_id.name','=','Vehicle')]</field>
        <field name="context">{'search_default_internal_loc': 1, 'search_default_stockable': 1, 'group_by': ['product_id', 'location_id']}</field>
        <field name="help">This analysis gives you a fast overview on the current stock level of your products and their current inventory value.</field>
    </record>

    <record model="ir.actions.act_window" id="quantsact2"> <!-- Menu + python -->
        <field name="name">Parts Inventory</field>
        <field name="res_model">stock.quant</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('category_id.name','=','Parts')]</field>
        <field name="context">{'search_default_internal_loc': 1, 'search_default_stockable': 1, 'group_by': ['product_id', 'location_id']}</field>
        <field name="help">This analysis gives you a fast overview on the current stock level of your products and their current inventory value.</field>
    </record>
</odoo>