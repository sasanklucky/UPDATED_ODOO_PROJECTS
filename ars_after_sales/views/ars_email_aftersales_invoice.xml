
<odoo>

    <template id="ars_portal_aftersales_page" name="Sales Order">
      <t t-call="portal.portal_layout">
        <t t-set="sales_order" t-value="order"/> <!-- rename to ensure breadcrumb compatibility (differentiate with purchase orders) -->
        <t t-set="invoices" t-value="[i for i in order.invoice_ids if i.state not in ['draft', 'cancel']]"/>
        <t t-set="invoices_amount" t-value="sum(i.amount_total for i in invoices)"/>
        <div id="optional_placeholder"></div>
        <div class="container">
          <div class="panel panel-default">
            <div class="panel-heading">
              <div class="row">

                  <div class="col-xs-12">
                        <a target="_blank" t-att-href="'/my/orders/pdf/%s?%s' % (order.id, keep_query())" class="ml8 pull-right mt4 mr8" title="Download">
                            <i class="fa fa-download fa-2x" aria-hidden="true"/>
                        </a>
                        <h2>
                            <strong>Estimation # </strong>
                            <span t-field="order.name"/>
                        </h2>
                  </div>

                  <div class="col-xs-12">
                        <div class="col-xs-12 table table-bordered">
                            <div class="col-xs-6">
                                <table class="table ">
                                    <tr><td>Customer:</td><td><span t-field="order.partner_id"
                                    t-options='{"widget": "contact", "fields": ["name"]}' /></td></tr>
                                    <tr><td>Address:</td><td><span t-field="order.partner_id"
                                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' /></td></tr>
                                    <tr><td>Mobile No: </td><td><span t-field="order.mobile"/></td></tr>
                                    <tr><td>Email: <ID></ID></td><td><span t-field="order.email"/></td></tr>
                                </table>
                            </div>
                            <div class="col-xs-6">
                                <table class="table">
                                    <!--<tr><td>Delivery Date&amp;Time</td><td><span t-field="order.delivery_date"/></td></tr>-->
                                    <tr>
                                        <td>Delivery Date&amp;Time</td>
                                        <td>
                                          <t t-if="delivery_date">
                                            <t t-set="delivery_date" t-value="datetime.datetime.strptime(order.delivery_date, '%Y-%m-%d %H:%M:%S')+datetime.timedelta(hours = 5, minutes = 30)"/>
                                            <span t-esc="delivery_date.strftime('%d/%m/%Y %H:%M:%S')"/>
                                          </t>
                                        </td>
                                    </tr>
                                    <tr><td>Reg No</td><td><span t-field="order.regn_no.license_plate"/></td></tr>
                                    <tr><td>Vehicle Model</td><td><span t-field="order.model"/></td></tr>
                                    <tr><td>VIN</td><td><span t-field="order.vin_no"/></td></tr>
                                    <tr><td>Odometer Read</td><td><span t-field="order.mileage_in"/></td></tr>
                                    <tr><td>Service Advisor</td><td><span t-field="order.user_id.name"/></td></tr>
                                    <tr><td>S A Mobile No.</td><td><span t-field="order.user_id.mobile"/></td></tr>
                                </table>
                            </div>
                        </div>
                  </div>
                  
                    <div class="col-xs-12">
                        <table class="table table-bordered">
                            <thead>
                                <tr style="background-color:#F5F5F5;">
                                    <th>SL</th>
                                    <th>Demanded Repair(Customer Voice)</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody table-bordered" style="background-color:#FFFFF;">
                                <t t-foreach="order.customer_voice_sale" t-as="cus_voic">
                                    <tr class="active">
                                        <td style="background-color:#FFF;">
                                            <span t-esc="cus_voic_index+1"/>
                                        </td>
                                        <td style="background-color:#FFF;">
                                            <span t-field="cus_voic.name"/>
                                        </td>
                    
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                  
                  <div class="col-xs-12">
                        <div style="margin:10px 10px 10px 10px;font-weight:bold;">
                            <span style="font-size:16px;color:black;font-weight:bold;">Customer Demanded - Spares Estimate</span>
                        </div>
                        <table class="table table-bordered" style="background-color:#F5F5F5;">
                            <thead>
                                <tr>
                                    <th>SL</th>
                                    <th>Item Name</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-center">UOM</th>
                                    <th class="text-center">Category</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-right">Taxes</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody table-bordered">
                                <t t-set="p_product_amt" t-value="0"></t>
                                <!--<t t-set="p_product_tax" t-value="0"></t>-->
                                <t t-set="i" t-value="1" />
                                <t t-foreach="order.order_line" t-as="ord_lin">
                                    <t t-if="ord_lin.product_id.type == 'product'">
                                        <t t-set="p_product_amt" t-value="p_product_amt+ord_lin.price_subtotal"></t>
                                        <!--<t t-set="p_product_tax" t-value="p_product_tax+ord_lin.tax_id.id"></t>-->
                                        <tr class="active">
                                            <td style="background-color:#FFF;">
                                                <span t-esc="i"/>
                                                <t t-set="i" t-value="i+1"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_id.name"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_uom_qty"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_uom"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.category"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.price_unit"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-esc="', '.join(map(lambda x: (x.name), ord_lin.tax_id))"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
    
                                <tr class="text-right">
                                    <td colspan="6">
                                    </td>
                                    <td>
                                        <strong>Total: </strong>
                                    </td>
                                    <!--<td>-->
                                        <!--<span t-esc="p_product_tax" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>-->
                                    <!--</td>-->
                                    <td>
                                        <span t-esc="p_product_amt" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                  </div>

                  <div class="col-xs-12">
                        <div style="margin:10px 10px 10px 10px;font-weight:bold;">
                            <span style="font-size:16px;color:black;font-weight:bold;"> Customer Demanded - Services Estimate</span>
                        </div>
                        <table class="table table-bordered">
                            <thead>
                                <tr style="background-color:#F5F5F5;">
                                    <th>SL</th>
                                    <th>Item Name</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-center">UOM</th>
                                    <th class="text-center">Category</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-right">Taxes</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody table-bordered">
                                <t t-set="p_service_amt" t-value="0"></t>
                                <!--<t t-set="p_service_tax" t-value="0"></t>-->
                                <t t-set="i" t-value="1" />
                                <t t-foreach="order.order_line" t-as="ord_lin">
                                    <t t-if="ord_lin.product_id.type == 'service'">
                                        <t t-set="p_service_amt" t-value="p_service_amt+ord_lin.price_subtotal"></t>
                                        <!--<t t-set="p_service_tax" t-value="p_service_tax+ord_lin.tax_id.id"></t>-->
                                        <tr class="active">
                                            <td style="background-color:#FFF;">
                                                <span t-esc="i"/>
                                                <t t-set="i" t-value="i+1"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_id.name"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_uom_qty"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.product_uom"/>
                                            </td>
                                            <td style="background-color:#FFF;">
                                                <span t-field="ord_lin.category"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.price_unit"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <!--<span t-field="ord_lin.tax_id.name"/>-->
                                                <span t-esc="', '.join(map(lambda x: (x.name), ord_lin.tax_id))"/>
                                            </td>
                                            <td class="text-right" style="background-color:#FFF;">
                                                <span t-field="ord_lin.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <tr class="text-right" style="background-color:#F5F5F5;">
                                    <td colspan="6">
                                    </td>
                                    <td>
                                        <strong>Total: </strong>
                                    </td>
                                    <!--<td>-->
                                        <!--<span t-esc="p_service_tax" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>-->
                                    <!--</td>-->
                                    <td>
                                        <span t-esc="p_service_amt" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                  <div class="col-xs-12 clearfix">
                    <div class="pull-left">
                        <span class="pull-left" style="font-size:16px;color:black;font-weight:bold;margin-right:400px;">Estimated Cost Of  - Services &amp; Spares</span>
                    </div>
                    <div id="total" class="row pull-right">
                        <div>
                            <table class="table-condensed" style="min-width: 250px;max-width: 400px;">
                                <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                    <td><strong>Spares Estimate:</strong></td>
                                    <td class="text-right">
                                        <span t-esc="p_product_amt" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                    <td><strong>Services Estimate:</strong></td>
                                    <td class="text-right">
                                        <span t-esc="p_service_amt" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                    <td><strong>Total Tax:</strong></td>
                                    <td class="text-right">
                                        <span t-field="order.amount_tax" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                    <td class="pull-right"><strong>Grand Total: </strong></td>
                                    <td class="text-right">
                                        <span t-field="order.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

              </div>
                
                
            </div>
          </div>
        </div>
      </t>
    </template>

</odoo>