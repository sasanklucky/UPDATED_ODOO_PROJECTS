<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

	<template id="report_invoice_inherit" inherit_id="account.report_invoice_document">

		<xpath expr="//div[@class='row']" position="replace">
		</xpath>
		<xpath expr="//h2" position="replace">

			<div class="col-xs-12">
				<h2>
					<strong>Invoice # </strong>
					<span t-field="o.number"/>
				</h2>
			</div>

			<div class="col-xs-12">
				<div class="col-xs-12 table table-bordered">
					<div class="col-xs-4">
						<table class="table ">
							<tr>
								<td>Customer:</td>
								<td>
									<t t-if="o.partner_id.parent_id">
										<span t-field="o.partner_id.parent_id.name"></span>
									</t>
									<t t-if="not o.partner_id.parent_id">
										<span t-field="o.partner_id.name"></span>
									</t>
								</td>
							</tr>
							<tr><td>Address:</td><td><span t-field="o.partner_id"
							t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' /></td></tr>
							<tr><td>Mobile No: </td><td><span t-field="o.order_id.mobile"/></td></tr>
							<tr><td>Email: <ID></ID></td><td><span t-field="o.order_id.email"/></td></tr>
						</table>
					</div>
					<div class="col-xs-4">
						<table class="table">
							<tr><td>Reg No</td><td><span t-field="o.order_id.regn_no.license_plate"/></td></tr>
							<tr><td>Vehicle Model</td><td><span t-field="o.order_id.model"/></td></tr>
							<tr><td>VIN</td><td><span t-field="o.order_id.vin_no"/></td></tr>
							<tr><td>KM In</td><td><span t-field="o.order_id.mileage_in"/></td></tr>
							<tr><td>Km Out</td><td><span t-field="o.order_id.mileage_in"/></td></tr>
						</table>
					</div>
					<div class="col-xs-4">
						<table class="table">
							<tr><td>Invoice Date</td><td><span t-field="o.date_invoice"></span></td></tr>
							<tr><td>RO Num</td><td><span t-field="o.origin"></span></td></tr>
							<tr><td>RO Date</td><td><span t-field="o.order_id.confirmation_date" t-field-options='{"format": "d MMMM y"}'></span></td></tr>
							<!--<tr><td>Delivery Date&amp;Time</td><td><span t-field="o.order_id.delivery_date"/></td></tr>-->
							<tr>
								<td>Delivery Date&amp;Time</td>
								<td>
									<t t-if="o.delivery_date">
										<t t-set="delivery_date" t-value="datetime.datetime.strptime(o.delivery_date, '%Y-%m-%d %H:%M:%S')+datetime.timedelta(hours = 5, minutes = 30)"/><span t-esc="delivery_date.strftime('%d/%m/%Y %H:%M:%S')"/></t></td>

							</tr>
							<tr><td>Service Advisor</td><td><span t-field="o.order_id.user_id.name"/></td></tr>
							<tr><td>S A Mobile No.</td><td><span t-field="o.order_id.user_id.mobile"/></td></tr>
						</table>
					</div>
				</div>
			</div>

		</xpath>
		<xpath expr="//div[@class='row mt32 mb32']" position="replace">
		</xpath>


		<xpath expr="//div[@class='clearfix']" position="after">
			<div style="">
				<label string="Terms &amp; Conditions"/><b>Terms &amp; Conditions : </b><br></br>
				<label string="* Supplimentry Estimate will be provided on further  dismanting/diagnosis of the Part"/><b>* Supplimentry Estimate will be provided on further  dismanting/diagnosis of the Part</b><br></br>
				<label string="* Diagnosis &amp; Estimate charges will be applicable if vehicle is taken without  repairs performed."/><b>* Diagnosis &amp; Estimate charges will be applicable if vehicle is taken without  repairs performed.</b><br></br>
				<label string="* Delivery against availablity of the parts."/><b>* Delivery against availablity of the parts.</b><br></br>
			</div>
			<div class="row text-center">
				<div class="pull-left">
					<h4 style="margin: 87px 0px 10px 36px; text-decoration: overline;">Authorized Signature</h4>
				</div>
				<div class="pull-right">
					<h4 style="margin: 87px 37px 10px 36px; text-decoration: overline;">Customer Signature</h4>
				</div>
			</div>
		</xpath>
	</template>


    <template id="ars_gst_inherit" inherit_id="l10n_in.l10n_in_report_invoice_document_inherit">
		<xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-if="o.company_id.country_id.code == 'IN'">
                <!-- Tag wise Tax Calculation -->
                <t t-set="tag_cgst_id" t-value="env.ref('l10n_in.cgst_tag_tax').id"/>
                <t t-set="tag_sgst_id" t-value="env.ref('l10n_in.sgst_tag_tax').id"/>
                <t t-set="tag_igst_id" t-value="env.ref('l10n_in.igst_tag_tax').id"/>
                <t t-set="tag_cess_id" t-value="env.ref('l10n_in.cess_tag_tax').id"/>
                <t t-set="tax_map" t-value="o.tax_line_ids.mapped('tax_id.tag_ids.id')"/>
                <t t-set="is_igst" t-value="tag_igst_id"/>
                <t t-set="is_cgst" t-value="tag_cgst_id"/>
                <t t-set="is_cess" t-value="tag_cess_id"/> <!-- in tax_map -->
                <t t-set="tax_datas" t-value="o._invoice_line_tax_values()"/>
            </t>
        </xpath>
        <xpath expr="//p[@t-if='o.comment']" position="replace">
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="replace">
