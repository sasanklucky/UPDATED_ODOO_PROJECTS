													<!--<t t-if="tax_data['amount'] < 0 ">-->
														<!--<t t-esc="0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>-->
													<!--</t>-->
													<t t-set="p_product_cess" t-value="p_product_cess+tax_data['amount']"></t>
												</t>
											</t>
										</td>
									</t>
									<!--<t t-set="total_cess" t-value="0.0"/>-->
									<!--<td class="text-right" t-if="is_cess">-->
										<!--<t t-foreach="tax_datas[l.id]" t-as="tax_data">-->
											<!--<t t-if="tag_cess_id in tax_data['tag_ids']">-->
												<!--<t t-set="total_cess" t-value="total_cess + tax_data['amount']"/>-->
											<!--</t>-->
										<!--</t>-->
										<!--<t t-esc="total_cess"/>-->
									<!--</td>-->
								</t>
								<td class="text-right" id="subtotal" style="background-color:#FFF;">
									<span t-field="l.price_subtotal"
										t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
							</t>
							</tr>
						<t t-if="not is_igst">
							<tr class="text-right" style="background-color:#F5F5F5;">
								<td colspan="5">
								</td>
								<td>
									<strong>Total: </strong>
								</td>
								<td>
									<span t-esc="p_product_cgst" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
								<td>
									<span t-esc="p_product_sgst" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
								<td>
									<span t-esc="p_product_cess" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
								<td>
									<span t-esc="p_product_amt" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
							</tr>
						</t>
						<t t-if="'is_igst' and 'is_cgst'">
							<tr class="text-right" style="background-color:#F5F5F5;">
								<td colspan="5">
								</td>
								<td>
									<strong>Total: </strong>
								</td>
								<td>
									<span t-esc="p_product_cgst" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
