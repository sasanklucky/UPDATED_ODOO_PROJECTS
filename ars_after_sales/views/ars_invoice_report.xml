								<td colspan="7">
								</td>
								<td>
									<strong>Total: </strong>
								</td>
								<td>
									<span t-esc="p_product_igst" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
								<td>
									<span t-esc="p_product_cess" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
								<td>
									<span t-esc="p_product_amt" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
								</td>
							</tr>
						</t>
					</tbody>
				</table>
			</div>

			<!--<t t-set="service_line" t-value="0">-->
