<odoo>
    <data>

        <record model="ir.actions.act_window" id="crm_customer_vehicle">
            <field name="name">Vehicle</field>
            <field name="res_model">stock.production.lot</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ars_vehicle_sales.ars_vehicle_view_form_inherit"/>
        </record>

        <record id="view_partners_form_ars_inherited" model="ir.ui.view">
            <field name="name">view.res.partner.form.ars.inherited</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field eval="18" name="priority"/>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="arch" type="xml">
                <data>
                    <button name="toggle_active" position="before">
                        <button class="oe_stat_button o_res_partner_tip_opp" type="object" name="crm_customer_vehicle"
                                icon="fa-car">
                            <field string="Vehicle" name="vehicle_count" widget="statinfo"/>
                        </button>
                    </button>

                    <xpath expr="//group/group/field[@name='vat']" position="before">
                        <field name="pan_no" string="PAN No"/>
                    </xpath>
                    <group name="purchase" position="inside">
                        <field name="add_as_seller"/>
                    </group>
                    <field name="function" position="after">
                        <field name="dob" placeholder="Date of birth"
                               attrs="{'invisible': [('is_company','=', True)]}"/>
                        <field name="age" placeholder="Age" attrs="{'invisible': [('is_company','=', True)]}"/>
                        <field name="gender" attrs="{'invisible': [('is_company','=', True)]}"/>
                        <field name="annual_income" options="{'no_create': True, 'no_open': True}"/>
                    </field>
                    <field name="mobile" position="attributes">
                        <attribute name="required">1</attribute>
                    </field>
                    <field name="email" position="attributes">
                        <attribute name="required">1</attribute>
                    </field>
                    <field name="city" position="attributes">
                        <attribute name="required">1</attribute>
                    </field>
                </data>
            </field>
        </record>

    </data>
</odoo>
