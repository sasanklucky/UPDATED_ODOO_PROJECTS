<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="crm_lead_appointment_form_inherited" model="ir.ui.view">
            <field name="name">CRM Appointment Lead Inherited</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="ars_after_sales.crm_case_form_view_oppor_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/group/group[1]/field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group/group[1]/field[@name='mobile']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group/group[2]/field[@name='vehicle_model']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group/group[2]/field[@name='vin_no']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group/group[2]/div/div[hasclass('oe_inline')]/field[@name='regn_no']"
                       position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group[2]/group/field[@name='appo_date']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group/group[2]/field[@name='kilometer_in']" position="after">
                    <field name="sale_date_to_customer" attrs="{'required': True}"/>
                </xpath>
                <xpath expr="/form/sheet/group[2]/group/field[@name='user_id']" position="attributes">
                    <attribute name="attrs">{'required': True}</attribute>
                </xpath>
                <xpath expr="/form/sheet/group[2]/group/field[@name='user_id']" position="after">
                    <field name="service_options" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                    <field name="service_type" attrs="{'required': True}" domain="[('service_option_id', '=',service_options)]" options="{'no_create': True,}"/>
                </xpath>
                <xpath expr="/form/sheet/group[2]/group[2]/field[@name='date_conversion']" position="after">
                    <field name="pick_up_drop_crm" attrs="{'required': True}"/>
                </xpath>
            </field>
        </record>
