                                </td>
                                <td class="text-right" id="price_total" style="background-color:#FFF;">
                                    <!--                                        <span t-field="l.price_total"/>-->
                                    <span t-esc="'{:,.2f}'.format(l.price_total)"/>
                                    <t t-set="p_service_total_amt"
                                       t-value="p_service_total_amt+l.price_total"></t>
                                </td>
                            </t>
                        </tr>
                        <t t-if="not is_igst">
                            <tr class="text-right" style="background-color:#F5F5F5;">
                                <t t-if="display_discount">
                                    <td colspan="6"/>
                                </t>
                                <t t-if="not display_discount">
                                    <td colspan="5"/>
                                </t>
                                <td>
                                    <strong>Total:</strong>
                                </td>
                                <td>
                                    <span t-esc="round(p_service_amt,2)"/>
                                </td>
                                <td></td>

                                <td>
                                    <span t-esc="round(p_service_tax_amt,2)"/>
                                </td>
                                <td>
                                    <span t-esc="round(p_service_total_amt,2)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div id="total" class="row">
                    <div class="col-xs-4 pull-right">
                        <table class="table-condensed"
                               style="min-width: 250px;max-width: 400px;page-break-inside: avoid;margin-left: 70px;">
                            <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                <td>
                                    <strong>Parts Amount</strong>
                                </td>
                                <td class="text-right">
                                    <!--                                    <span t-esc="p_product_amt"/>-->
                                    <span t-esc="round(p_product_amt,2)"/>
                                </td>
                            </tr>
                            <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                <td>
                                    <strong>Labour Amount</strong>
                                </td>
                                <td class="text-right">
                                    <span t-esc="round(p_service_amt,2)"/>
                                </td>
                            </tr>
                            <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                <td>
                                    <strong>Subtotal</strong>
                                </td>
                                <td class="text-right">
                                    <!--                                    <span t-field="o.amount_untaxed"/>-->
                                    <span t-esc="'{:,.2f}'.format(doc.amount_untaxed)"/>
                                </td>
                            </tr>
                            <t t-foreach="doc._get_tax_amount_by_group()" t-as="amount_by_group">
                                <tr style="border-bottom:1px solid #dddddd;">
                                    <t t-if="amount_by_group[3] == 1 and doc.amount_untaxed == amount_by_group[2]">
                                        <td>
                                            <span t-esc="amount_by_group[0]"/>
                                            <span>&amp;nbsp;<span>on</span>&amp;nbsp;<t t-esc="amount_by_group[2]" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/></span>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="amount_by_group[1]"
                                                t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </t>
                                    <t t-else ="">
                                        <td>
                                            <span t-esc="amount_by_group[0]"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="amount_by_group[1]"
                                                t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                            <tr class="border-black">
                                <td>
                                    <strong>Grand Total</strong>
                                </td>
                                <td class="text-right">
                                    <!--                                    <span t-field="o.amount_total"/>-->
                                    <span t-esc="'{:,.2f}'.format(doc.amount_total)"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
