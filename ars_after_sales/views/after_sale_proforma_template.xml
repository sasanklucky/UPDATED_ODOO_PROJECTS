                        <tr t-foreach="doc.order_line" t-as="l">
                            <t t-if="l.product_id.type == 'service'">
                                <t t-set="p_service_amt" t-value="p_service_amt+l.price_subtotal"></t>
                                <td style="background-color:#FFF;">
