                                <td class="text-right" style="background-color:#FFF;">
                                    <!--                                        <span t-field="l.quantity"/>-->
                                    <span t-esc="l.product_uom_qty"/>
                                </td>
                                <td style="background-color:#FFF;">
                                    <span t-field="l.product_uom"/>
                                </td>
                                <td t-if="display_discount" class="text-right">
