<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="proforma_template_new" name="Pro-Forma After Sales">
        <t t-call="web.html_container">

            <div style="font-weight:bold;width:100%;padding: 15px 2px;text-align: center;margin-bottom:4px;">
                <span style="font-size:16px;color:black;font-weight:bold;">
                    Pro-Forma Invoice
                </span>
            </div>
            <div class="col-xs-12" style="padding: revert;">
                <div style="font-weight:bold;width:100%;background-color:#e0e0e0;padding: 0px 2px;text-align: center;">
                    <span style="font-size:16px;color:black;font-weight:bold;">
                        Customer &amp; Vehicle Info
                    </span>
                </div>
            </div>
            <div class="col-xs-6">
                <table class="" style="margin-bottom: 2px;">
                    <tr>
                        <td>Customer Name</td>
                        <td>:</td>
                        <td>
                            <t t-if="doc.partner_id.parent_id">
                                <span t-field="doc.partner_id.parent_id.name"></span>
                            </t>
                            <t t-if="not doc.partner_id.parent_id">
                                <span t-field="doc.partner_id.name"></span>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td>GSTIN</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.partner_id.vat"/>
                        </td>
                    </tr>
                    <tr>
                        <td>Address</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.partner_id"
                                  t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-xs-6">
                <table class="">
                    <tr>
                        <td>Reg Number</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.regn_no"/>
                        </td>

                    </tr>
                    <tr>
                        <td>Vehicle Model</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.model"/>
                        </td>
                    </tr>
                    <tr>
                        <td>VIN Number</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.vin_no"/>
                        </td>
                    </tr>
                    <tr>
                        <td>Date of Sale</td>
                        <td>:</td>
                        <td>
                            <t t-if="doc.regn_no">
                                <t t-if="doc.regn_no.customer_ids">
                                    <span t-esc="doc.regn_no.customer_ids.mapped('date_of_ownership')[0]"/>
                                </t>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td>KM</td>
                        <td>:</td>
                        <td>
                            <span t-field="doc.mileage_in"/>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-xs-12" style="padding: revrevertert;">
                <div style="font-weight:bold;width:100%;background-color:#e0e0e0;padding: 0px 2px;text-align: center;">
                    <span style="font-size:16px;color:black;font-weight:bold;">
                        Service Info
                    </span>
                </div>
                <div class="col-xs-6">
                    <table class="" style="margin-bottom: 2px;">
                        <!--							<tr><td>Invoice Date</td><td><span t-field="o.date_invoice"></span></td></tr>-->
                        <tr>
                            <td>RO Number</td>
                            <td>:</td>
                            <td>
                                <span t-field="doc.name"></span>
                            </td>
                        </tr>
                        <tr>
                            <td>RO Date</td>
                            <td>:</td>
                            <td>
                                <span t-field="doc.confirmation_date"
                                      t-field-options='{"format": "d MMMM y"}'></span>
                            </td>
                        </tr>
                        <tr>
                            <td>Service Type</td>
                            <td>:</td>
                            <td>
                                <span t-field="doc.service_type.name"></span>
                            </td>
                        </tr>
                        <tr>
                            <td>Delivery Date&amp;Time</td>
                            <td>:</td>
                            <td>
                                <t t-if="doc.delivery_date">
                                    <t t-set="delivery_date"
                                       t-value="datetime.datetime.strptime(doc.delivery_date, '%Y-%m-%d %H:%M:%S')+datetime.timedelta(hours = 5, minutes = 30)"/>
                                    <span t-esc="delivery_date.strftime('%d/%m/%Y %H:%M:%S')"/>
                                </t>
                            </td>

                        </tr>
                    </table>
                </div>
                <div class="col-xs-6">
                    <table class="">
                        <tr>
                            <td>Service Advisor</td>
                            <td>:</td>
                            <td>
                                <span t-field="doc.user_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td>SA Mobile No</td>
                            <td>:</td>
                            <td>
                                <span t-field="doc.user_id.mobile"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="col-xs-12" name="parts_details-after_sale" id="parts_info_after_sales">
                <div style="font-weight:bold;width:100%;background-color:#e0e0e0;padding: 0px 2px;text-align: center;">
                    <span style="font-size:16px;color:black;font-weight:bold;">Parts Details</span>
                </div>
                <table class="table-bordered" name="invoice_line_table" style="margin-bottom: 2px;width: 100%;">
                    <thead>
                        <tr style="background-color:#F5F5F5;">
                            <th>SL</th>
                            <th>Part Number</th>
                            <th>Item Name</th>
                            <th>HSN Code</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Qty</th>
                            <th class="text-center">UOM</th>

                            <th t-if="display_discount" class="text-right">Disc.(%)</th>
                            <th class="text-right">Amount</th>

                            <th class="text-right">Taxes</th>

                            <t t-if="doc.company_id.country_id.code == 'IN'">

                            </t>
                            <th class="text-right">Tax Amt</th>
                            <th class="text-right">Total</th>

                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="p_product_amt" t-value="0"></t>
                        <t t-set="p_total_amt" t-value="0"></t>
                        <t t-set="p_tax_amt" t-value="0"></t>
                        <t t-set="p_product_cgst" t-value="0"></t>
                        <t t-set="p_product_sgst" t-value="0"></t>
                        <t t-set="p_product_igst" t-value="0"></t>
                        <t t-set="p_product_cess" t-value="0"></t>
                        <t t-set="i" t-value="1"/>
                        <tr t-foreach="doc.order_line" t-as="l">
                            <t t-if="l.product_id.type in ['product','consu']">
                                <t t-set="p_product_amt" t-value="p_product_amt+l.price_subtotal"></t>
                                <td style="background-color:#FFF;">
                                    <span t-esc="i"/>
                                    <t t-set="i" t-value="i+1"/>
                                </td>
                                <td class="text-right" style="background-color:#FFF;">
                                    <span t-field="l.product_id.default_code"/>
                                </td>
                                <td style="background-color:#FFF;">
                                    <span t-field="l.product_id.name"/>
                                </td>
                                <td class="text-right" style="background-color:#FFF;">
                                    <span t-field="l.product_id.l10n_in_hsn_code"/>
                                </td>
                                <td class="text-right" style="background-color:#FFF;">
                                    <span t-field="l.price_unit"/>
                                </td>
                                <td class="text-right" style="background-color:#FFF;">
                                    <span t-esc="l.product_uom_qty"/>
                                </td>
                                <td style="background-color:#FFF;">
                                    <span t-field="l.product_uom"/>
                                </td>

                                <td t-if="display_discount" class="text-right">
                                    <span t-field="l.discount"/>
                                </td>
                                <td class="text-right" style="background-color:#FFF;">

                                    <span t-esc="'{:,.2f}'.format(l.price_subtotal)"/>
                                </td>
                                <t style="background-color:#FFF;">
                                    <td class="text-right">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                    </td>
                                </t>

                                <td class="text-right" id="subtotal" style="background-color:#FFF;">
                                    <t t-set="tax_amt" t-value="l.price_total-l.price_subtotal"></t>
                                    <span t-esc="round(tax_amt,2)"/>
                                    <t t-set="p_tax_amt" t-value="p_tax_amt+tax_amt"></t>
                                </td>
                                <td class="text-right" id="price_total" style="background-color:#FFF;">
                                    <span t-esc="'{:,.2f}'.format(l.price_total)"/>
                                    <t t-set="p_total_amt" t-value="p_total_amt+l.price_total"></t>
                                </td>
                            </t>
                        </tr>
                        <t t-if="not is_igst">
                            <tr class="text-right" style="background-color:#F5F5F5;">
                                <t t-if="display_discount">
                                    <td colspan="7"/>
                                </t>
                                <t t-if="not display_discount">
                                    <td colspan="6"/>
                                </t>
                                <td>
                                    <strong>Total:</strong>
                                </td>
                                <td>
                                    <span t-esc="round(p_product_amt,2)"/>
                                </td>
                                <td></td>

                                <td>
                                    <span t-esc="round(p_tax_amt,2)"/>
                                </td>
                                <td>
                                    <span t-esc="round(p_total_amt,2)"/>
                                </td>
                            </tr>

                        </t>
                        <!--                        <t t-if="'is_igst' and 'is_cgst'">-->
                        <!--                            <tr class="text-right" style="background-color:#F5F5F5;">-->
