<odoo>
    <data>
        <record model="ir.ui.view" id="ac_service_type_list">
            <field name="name">service_type list</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="name"/>
                    <field name="service_option_id" options="{'no_create': True, 'no_open': True}"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="ac_service_options_list">
            <field name="name">service_type list</field>
            <field name="model">service.options</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="name"/>
<!--                    <field name="service_type"/>-->
                    <field name="warranty_ir_seq" required="1" options="{'no_create': True}"/>
                </tree>
            </field>
        </record>

<!--        <record model="ir.ui.view" id="ac_service_type_form">-->
<!--            <field name="name">service type form</field>-->
<!--            <field name="model">service.type</field>-->
<!--            <field name="arch" type="xml">-->
<!--                <form>-->
<!--                    <group col="4" string="Product Catalog">-->
<!--                        <field name="name"/>-->
<!--                    </group>-->
<!--                </form>-->
<!--            </field>-->
<!--        </record>-->

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ac_service_type_window">
            <field name="name">Service Type Window</field>
            <field name="res_model">service.type</field>
            <field name="view_mode">tree</field>
        </record>

        <record model="ir.actions.act_window" id="ac_service_options_window">
            <field name="name">Service Option Window</field>
            <field name="res_model">service.options</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem name="Service Options" id="ac_service_options_menu" parent="menu_aftersales_config"
                  action="ac_service_options_window"/>

        <menuitem name="Service Type" id="ac_service_type_menu"
                  parent="menu_aftersales_config"
                  groups="base.group_no_one"
                  action="ac_service_type_window"/>
    </data>
</odoo>
