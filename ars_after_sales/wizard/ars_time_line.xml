<odoo>
  <data>
    <record id="time_line_popup" model="ir.ui.view">
        <field name="name">Time Line</field>
        <field name="model">time.line</field>
        <field name="arch" type="xml">
            <tree string="Time Line">
                <field name="main_process_id"/>
                <field name="start"/>
                <field name="end"/>
                <field name="user"/>
            </tree>
        </field>
    </record>
    <record id="action_time_line" model="ir.actions.act_window">
         <field name="name">Time Line</field>
         <field name="res_model">time.line</field>
         <field name="type">ir.actions.act_window</field>
         <field name="view_type">form</field>
         <field name='limit'>20</field>
         <field name="view_mode">tree</field>
         <field name="view_id" ref="time_line_popup"/>
         <field name="target">new</field>
    </record>

  </data>
</odoo>
