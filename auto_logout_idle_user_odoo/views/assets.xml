            <script type="text/javascript" src="/auto_logout_idle_user_odoo/static/src/js/auto_log_out_notify.js"/>
            <link rel="stylesheet" href="/auto_logout_idle_user_odoo/static/src/css/auto_log_out_notify.css"/>
        </xpath>
    </template>
</odoo>