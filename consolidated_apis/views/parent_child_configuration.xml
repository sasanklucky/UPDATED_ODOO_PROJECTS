<odoo>
    <data>
    <record id="parent_child_configuration_form" model="ir.ui.view">
            <field name="name">parent_child_configuration.form</field>
            <field name="model">parent.child.configuration</field>
            <field name="arch" type="xml">
                <form string="">
                  <sheet>
                    <group col="4">
                        <field name="connection_type"/>
                        <field name="child_id" options="{'no_create': True, 'no_open': True}"/>
                        <!-- <field name="internal_url"/> -->
                        <field name="external_url"/>
                        <field name="db_name"/>
                    </group>
                    
                  </sheet>
                </form>
            </field>
        </record>

        <record id="parent_child_configuration_tree" model="ir.ui.view">
            <field name="name">parent_child_configuration.tree</field>
            <field name="model">parent.child.configuration</field>
            <field name="arch" type="xml">
                <tree string="" editable='bottom'>
                        <field name="connection_type"/>
                        <field name="child_id" options="{'no_create': True, 'no_open': True}"/>
                        <!-- <field name="internal_url"/> -->
                        <field name="external_url" attrs="{'readonly': [('connection_type', '=','internal')]}"/>
                        <field name="db_name"/>
                </tree>
            </field>
        </record>

        <record id="parent_child_configuration_process" model="ir.actions.act_window">
            <field name="name">DB Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">parent.child.configuration</field>
            <field name="view_type">form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('consolidated_apis.parent_child_configuration_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('consolidated_apis.parent_child_configuration_form')})]"/>
            <field name="help">This is parent-child company configuration master.</field>
        </record>


    </data>
</odoo>