<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--Scheduled Action for sending Vehicle-Sales PSF report(RSA)-->
        <record id="ir_cron_send_aftersales_psf_report_rsa" model="ir.cron">
            <field name="name">PSF report(RSA)</field>
            <field name="model_id" ref="model_vehicle_sale_psf_report"/>
            <field name="state">code</field>
            <field name="code">model.send_psf_rsa_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
        </record>

        <record id="ir_cron_send_aftersales_report_rsa" model="ir.cron">
            <field name="name">RSA report(RSA)</field>
            <field name="model_id" ref="model_vehicle_sale_rsa_report"/>
            <field name="state">code</field>
            <field name="code">model.send_rsa_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
        </record>

        <record id="ir_cron_send_aftersales_vehiclesale_report" model="ir.cron">
            <field name="name">CSI and SSI Data</field>
            <field name="model_id" ref="model_automated_report"/>
            <field name="state">code</field>
            <field name="code">model.send_csi_ssi_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1001</field>
        </record>

        <record id="ir_cron_send_ecb_report" model="ir.cron">
            <field name="name">ECB Data</field>
            <field name="model_id" ref="ac_vehicle_management.model_vehicle_sale_psf_report"/>
            <field name="state">code</field>
            <field name="code">model.send_ecb_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">10</field>
        </record>


        <record id="ir_cron_pipeline_stage_modifier" model="ir.cron">
            <field name="name">Crm pipeline stages update</field>
            <field name="model_id" ref="ac_vehicle_management.model_mail_activity"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_lead_stages()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
        </record>
    </data>
</odoo>
