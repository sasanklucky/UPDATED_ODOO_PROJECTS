<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tree view for "retail.report" -->
        <record id="vehicle_sale_psf_report_tree" model="ir.ui.view">
            <field name="name">vehicle.sale.psf.report.tree</field>
            <field name="model">vehicle.sale.psf.report</field>
            <field name="type">tree</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <tree string="vehicle_sale_report_tree" create="false" delete="false" edit="false" default_order='invoice_number asc'>
                    <field name="month" string="Month" />
                    <field name="year" string="Year" />
                    <field name="dealer_name_id" string="Dealer Name" />
                    <field name="invoice_date" string="Invoice Date" />
                    <field name="invoice_number" string="Invoice Number" />
<!--                    <field name="ro_open_date" string="RO Open Date" />-->
<!--                    <field name="ro_number" string="RO Number" />-->
<!--                    <field name="ro_close_date" string="RO Close Date" />-->
                    <field name="user_id" string="Sales Person"/>
                    <field name="partner_id" string="Customer Name" />
                    <field name="mobile" string="Customer Mobile" />
                    <field name="city" string="Customer City" />
                    <field name="phone" string="Customer Phone" />
                    <field name="pan_no" string="Customer Pan No." />
                    <field name="vin" string="VIN" />
                    <field name="model" string="Model" />
                    <field name="amount_untaxed" string="Untaxed Amount" />
                    <field name="amount_tax" string="Tax" />
                    <field name="amount_total" string="Total" />
<!--                    <field name="service_options_id" string="Service Options" />-->
<!--                    <field name="service_type_id" string="Service Type" />-->
<!--                    <field name="doc_type" string="Type" />-->
<!--                    <field name="user_id" string="Service Advisor" />-->
<!--                    <field name="reg_no" string="Reg No." />-->

                    <field name="delivery_date" string="Delivery Date" />
                    <field name="delivery_address1" string="Delivery Address 1" />
                    <field name="delivery_address2" string="Delivery Address 2" />
                </tree>
            </field>
        </record>

        <!-- Search view for "retail.report" -->
        <record id="view_vehicle_sale_psf_report_search" model="ir.ui.view">
            <field name="name">view.vehicle.psf.report.search</field>
            <field name="model">vehicle.sale.psf.report</field>
            <field name="type">search</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
            <field name="active" eval="True" />
            <field name="arch" type="xml">
                <search string="vehicle_sale_psf_report_search">
                    <field name="invoice_number"/>
                </search>
            </field>
        </record>

        <!-- Main window action for "retail.report" -->
        <record id="action_vehicle_sale_psf_report_act_window" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Vehicle Sale Psf Report</field>
            <field name="res_model">vehicle.sale.psf.report</field>
            <field name="view_mode">tree</field>
            <field name="view_type">form</field>
            <field name="target">current</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="search_view_id" ref="view_vehicle_sale_psf_report_search" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Vehicle Sale Psf Report
                </p>
            </field>
        </record>

        <!-- Main menu for "retail.report" -->
        <record id="menu_vehicle_sale_psf_report_accounting" model="ir.ui.menu" >
            <field name="name">Vehicle Sales PSF Report</field>
            <!-- <field name="sequence" eval="10" /> -->
            <field name="action" ref="action_vehicle_sale_psf_report_act_window" />
            <field name="parent_id" ref="account.account_reports_management_menu" />
        </record>



    </data>
</odoo>
