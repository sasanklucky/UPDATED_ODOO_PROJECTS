<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tree view for "retail.report" -->
        <record id="view_automation_email_conf_tree" model="ir.ui.view">
            <field name="name">view_automation_email_conf_tree</field>
            <field name="model">automation.email.conf</field>
            <field name="type">tree</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml">
                <tree>
<!--                    <field name="mail_list_ids" string="Mail Partners"/>-->
<!--                    <field name="psf_rsa_report" string="Vehicle-Sales PSF RSA Report"/>-->
                    <field name="report_template_id" string="Mail Template"/>
                    <field name="mail_template" string="Mail Body"/>
                    <field name="mail_subject" string="Mail Subject"/>
                </tree>
            </field>
        </record>

        <record id="view_automation_email_conf_form" model="ir.ui.view">
            <field name="name">view_automation_email_conf_form</field>
            <field name="model">automation.email.conf</field>
            <field name="type">form</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="mail_list_ids" widget="many2many_tags"
                                   string="Mail Partners"/>
                        </group>
                        <group>
                            <field name="psf_rsa_report" string="Vehicle-Sales PSF RSA Report"/>
                            <field name="csi_ssi_report" string="SSI CSI Report"/>
                            <field name="ecb_report" string="ECB Report"/>
                            <field name="report_template_id" string="Mail Template"/>
                        </group>
                        <notebook>
                            <page string="Mail Template">
                                <field name="mail_template" string="Mail Body"/>
                            </page>
                            <page string="Mail Subject">
                                <field name="mail_subject" string="Mail Subject"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Main window action for "retail.report" -->
        <record id="action_automation_email_conf_act_window" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Automation Email Conf</field>
            <field name="res_model">automation.email.conf</field>
            <field name="view_mode">tree,form</field>
            <field name="target">current</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Automation Email Conf
                </p>
            </field>
        </record>

        <!-- Menu for Automation Email Conf -->
        <menuitem id="menu_automation_email_conf" action="action_automation_email_conf_act_window"
                  parent="base.menu_automation"/>

    </data>
</odoo>