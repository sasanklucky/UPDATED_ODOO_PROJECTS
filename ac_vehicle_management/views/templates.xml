        <record id="crm_sequence_enquiry" model="ir.ui.view">
            <field name="name">Crm Sequence</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_form_view_leads"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='extra']/group/group[2]/field[@name='company_id']" position="after">
                    <field name="crm_sequence"/>
                    <field name="source_reference"/>
                </xpath>
            </field>
        </record>

        <template id="assets_backend" name="mail assets restrict unlink" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                <script type="text/javascript" src="/ac_vehicle_management/static/src/js/activity_unlink_restrict.js"/>
                <script type="text/javascript" src="/ac_vehicle_management/static/src/js/crm_lead_hide_edit_V.js"/>
            </xpath>
        </template>


         <record id="crm_lead_form_view_sales_form_inherit_won" model="ir.ui.view">
        <field name="name">crm.lead.sales.form.inherited.mark.won</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_set_won']" position="attributes">
            <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet" position="inside">
                    <field name="stage_name" invisible="1"/>
                </xpath>

                <!-- Hide button with name='360' based on stage name -->
                <xpath expr="//form/header/button[@name='360']" position="attributes">
                    <attribute name="attrs">{'invisible': [('stage_name', 'in', ['Booked', 'Retail'])]}</attribute>
                </xpath>
                <xpath expr="//form/sheet/div[@name='button_box']/button[@name='toggle_active']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                    <attribute name="attrs">{'invisible': [('active', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>