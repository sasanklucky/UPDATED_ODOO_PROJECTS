<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_service_psf_report" model="ir.ui.view">
        <field name="name">service.psf.report</field>
        <field name="model">service.excel.wiz</field>
        <field name="arch" type="xml">
            <form string="PSF Service Report">
                <group>
                    <field name='start_date'/>
                    <field name='end_date'/>
                </group>
                <footer>
                    <button name="action_psf_service" string="Print Service Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_service_psf_report_wizard" model="ir.actions.act_window">
        <field name="name">Create Service Order Message</field>
        <field name="res_model">service.excel.wiz</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ars_mail_survey.view_service_psf_report"/>
        <field name="view_type">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ars_mail_survey_service_psf"
                  name="PSF Service Report"
                  action="action_service_psf_report_wizard"
                  parent="crm.crm_menu_report"
                  sequence="1"/>
</odoo>