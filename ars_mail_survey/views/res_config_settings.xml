<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_sale_n_post_sale_config_rms_settings" model="ir.ui.view">
        <field name="name">ars_config_inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Sale and Post Sale" string="Sale and Post Sale" data-key="ars_invoice_aftersales">
                    <h2>Sale and Post Sales Activity Settings</h2>
                    <div class="row mt16 o_settings_container" id="sale_and_post_sale_settings">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="sale_and_post_sale_settings">
                            <div class="o_setting_right_pane">
                                <!-- <label string="Sale Followup Activity Days" /> -->
                                <div class="text-muted">
                                    Sale Followup Activity Days
                                </div>
                                <field name="sale_followup_days" />
                            </div>
                            <div class="o_setting_right_pane">
                                <!-- <label string="Post Sale Followup Activity Days" /> -->
                                <div class="text-muted">
                                    Post Sale Followup Activity Days
                                </div>
                                <field name="postsale_followup_days" />
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="sale_and_post_sale_settings">
                            <div class="o_setting_right_pane">
                                <!-- <label string="Sale Followup Activity Days" /> -->
                                <div class="text-muted">
                                    Sale Activity Survey
                                </div>
                                <field name="sale_survey_id" />
                            </div>
                            <div class="o_setting_right_pane">
                                <!-- <label string="Post Sale Followup Activity Days" /> -->
                                <div class="text-muted">
                                    Post Sale Activity Survey
                                </div>
                                <field name="post_sale_survey_id" />
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="sale_and_post_sale_settings">
                            <div class="o_setting_right_pane">
                                <!-- <label string="Sale Followup Activity Days" /> -->
                                <div class="text-muted">
                                    Survey Percentage
                                </div>
                                <field name="survey_percentage" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_sale_and_post_sale_config_settings" model="ir.actions.act_window">
        <field name="name">ARS Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_sale_n_post_sale_config_rms_settings" />
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'ars_invoice_aftersales'}</field>
    </record>
</odoo>