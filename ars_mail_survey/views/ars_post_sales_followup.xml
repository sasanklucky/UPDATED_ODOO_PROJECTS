<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_activity_view_tree_inherited" model="ir.ui.view">
            <field name="name">mail.activity.tree.inherit</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="after">
                    <field name="stages"/>
                </xpath>
            </field>
        </record>

        <record id="post_sales_followup_mail_activity_action" model="ir.actions.act_window">
            <field name="name">Post Service Followup Activity</field>
            <field name="res_model">mail.activity</field>
            <field name="view_type">form</field>
            <field name="view_id" ref="mail.mail_activity_view_tree"/>
            <field name="domain">[('invoice_type','=','after_sales')]</field>
        </record>


        <menuitem id="menu_post_sales_followup_mail_activity"
            name="Post Service Follow-up"
            parent="crm.crm_menu_root"
            action="post_sales_followup_mail_activity_action"
            sequence="6" />

        <template id="survey.back" name="Back">
            <div groups="website.group_website_publisher" t-ignore="true" class="pull-right">
                <t t-if="request.session.get('type') == 'activity'">
                    <a t-attf-href="/web#view_type=form&amp;model=mail.activity&amp;id=#{request.session.get('type_id')}&amp;action=#{request.session.get('action')}" class="btn btn-default">Back to Survey</a>
                </t>
                <t t-else="">
                    <a t-attf-href="/web#view_type=form&amp;model=survey.survey&amp;id=#{survey.id}&amp;action=survey.action_survey_form" class="btn btn-default">Back to Survey</a>
                </t>
            </div>
        </template>
    </data>
</odoo>