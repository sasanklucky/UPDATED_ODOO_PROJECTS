        <!-- Tree view for "helpdesk_category_i" -->
        <record id="view_helpdesk_category_i_tree" model="ir.ui.view">
            <field name="name">view.helpdesk_category_i.tree</field>
            <field name="model">helpdesk_category_i</field>
            <field name="type">tree</field>
            <field name="mode">primary</field>
            <field name="priority" eval="16" />
