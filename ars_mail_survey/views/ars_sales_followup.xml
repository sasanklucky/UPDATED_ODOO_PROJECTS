<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="sales_followup_mail_activity_view_form_inherit" model="ir.ui.view">
            <field name="name">mail.activity.view.form.popup</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <!-- <field name="compute_stages" invisible="1" /> -->
                        <field name="stages" invisible="1"/>
                        <field name="stages" widget="statusbar"
                               attrs="{'invisible': [('invoice_type','not in',('sales','after_sales'))]}"/>

                    </header>
                </xpath>
                <xpath expr="//field[@name='note']" position="before">
                    <attribute>
                        <label for="note" string="Remarks"/>
                    </attribute>
                </xpath>
                <xpath expr="//sheet/group" position="before">
                    <field name="invoice_type" invisible="1"/>
                    <div class="oe_button_box" name="button_box"
                         attrs="{'invisible': [('invoice_type','not in',('sales','after_sales'))]}">
                        <button name="action_start_survey" type="object" icon="fa-pencil-square-o" string="Survey">
                        </button>
                        <button name="get_invoice_form" type="object" icon="fa-pencil-square-o" string="Invoice">
                        </button>
                        <button name="customer_details" type="object" icon="fa-user" string="Customer">
                        </button>
                        <button name="ticket_details" type="object" class="oe_stat_button" icon="fa-ticket"
                                attrs="{'invisible': [('stages','not in',('ticket_created','completed'))]}">
                            <field name="ticket_count" widget="statinfo" string="Tickets "/>
                        </button>
                    </div>
                </xpath>
                <field name="activity_type_id" position="before">
                    <field name="res_name" string="Customer Name"/>
                </field>
                <field name="summary" position="after">
                    <field name="mobile" attrs="{'invisible': [('invoice_type','not in',('sales','after_sales'))]}"/>
                </field>
                <field name="user_id" position="after">
                    <separator colspan="4"/>
                    <field name="response_id" invisible="1"/>
                    <field name="survey_percentage" nolabel="1" widget='percentpie' style="cursor:pointer;"
                           attrs="{'invisible': [('invoice_type','not in',('sales','after_sales'))]}">
                        EntryProgress
                    </field>
                    <button name="create_helpdesk_ticket" type="object" icon="fa-ticket" string="Create Ticket"
                            attrs="{'invisible': ['|',('invoice_type','not in',('sales','after_sales')),('stages','in',('draft','ticket_created','completed'))]}">
                    </button>
                </field>

                <xpath expr="//footer" position="attributes">
                    <attribute name="invisible">[('invoice_type','not in',('sales','after_sales'))]</attribute>
                </xpath>
                <field name="note" position="after">
                    <button string="Schedule" name="action_close_dialog"
                            attrs="{'invisible': ['|',('activity_category', '=', 'meeting'),('stages','in',('survey_done','ticket_created','completed'))]}"
                            type="object" class="btn-primary"/>
                    <button string="Mark as Done" name="action_done"
                            attrs="{'invisible': ['|',('activity_category', '=', 'meeting'),('stages','=','completed')]}"
                            type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-default" special="cancel"/>
                </field>
                <!-- <field name="stages"  invisible="1"/>
                <xpath expr="//footer/button[@name='action_close_dialog']" position="attributes">
                    <attribute name="invisible">[('stages','in',('survey_done','completed'))]</attribute>
                </xpath>  -->
                <!-- <button name="action_done" position="attributes">
                    <attribute name="invisible">[('stages','in',['completed'])]</attribute>
                </button>  -->
                <xpath expr="//form/sheet" position="after">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </xpath>
            </field>
        </record>

        <record id="sales_followup_mail_activity_action" model="ir.actions.act_window">
            <field name="name">Post Sale Followup Activity</field>
            <field name="res_model">mail.activity</field>
            <field name="view_type">form</field>
            <field name="view_id" ref="mail.mail_activity_view_tree"/>
            <field name="domain">[('invoice_type','=','sales')]</field>
        </record>
        <menuitem id="menu_sales_followup_mail_activity"
                  name="Post Sales Follow-up"
                  parent="crm.crm_menu_root"
                  action="sales_followup_mail_activity_action"
                  sequence="5"/>
    </data>
</odoo>
